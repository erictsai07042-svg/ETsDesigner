<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>  
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% # theme-check-disable RemoteAsset %}
    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    {% # theme-check-enable RemoteAsset %}

<style>

/* Hero section 定位基準 */
.hero-wrapper {
  position: relative;
  overflow: visible;
}
/* ===== Scroll Down Indicator ===== */

.scroll-down-indicator {
  position: absolute;
  bottom: 50px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  z-index: 9999;
  pointer-events: none;
  animation: fadeInScroll 1.5s ease forwards;
}

.scroll-mouse {
  width: 26px;
  height: 40px;
  border: 2px solid #1A2E4A;
  border-radius: 13px;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding-top: 6px;
}

.scroll-wheel {
  width: 4px;
  height: 7px;
  background-color: #1A2E4A;
  border-radius: 2px;
  animation: scrollWheel 1.8s ease-in-out infinite;
}

@keyframes scrollWheel {
  0%   { transform: translateY(0);    opacity: 1;   }
  50%  { transform: translateY(10px); opacity: 0.3; }
  100% { transform: translateY(0);    opacity: 1;   }
}

.scroll-down-text {
  color: #1A2E4A;
  font-size: 11px;
  letter-spacing: 3px;
  font-weight: 500;
}

@keyframes fadeInScroll {
  0%   { opacity: 0; }
  100% { opacity: 1; }
}

@media (max-width: 768px) {
  /* 手機版隱藏 Scroll Down Indicator：
     手機使用者以滑動操作，圖示不必要且會遮蓋 CTA 按鈕 */
  .scroll-down-indicator {
    display: none !important;
  }
}
/* 隱藏 Horizon 內建 Scroll Indicator */
.hero__scroll-indicator,
.scroll-indicator,
[class*="scroll-indicator"] {
  display: none !important;
}

  :root {
    --icon-line-mono-url: url('{{ "icon-line-mono.svg" | asset_url }}');
  }

</style>
 
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height and menu style calculations to prevent layout shift
      // Note: Updates in calculateHeaderGroupHeight(), updateTransparentHeaderOffset() and setHeaderMenuStyle() utilities.js should be kept in sync with this function
      (function setHeaderHeighCustomProperties() {
        /*
         * Header calculation functions for maintaining CSS variables
         * Mimic calculateHeaderGroupHeight() in utilities.js
         */
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerTopRow = header.querySelector('.header__row--top');
        const headerHeight = header.offsetHeight;

        // Calculate the total height of the header group
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        // Check for transparent header special case
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        // Set CSS variables
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        if (headerTopRow) {
          window.requestAnimationFrame(function () {
            document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
          });
        }

        /**
         * Updates CSS custom properties for transparent header offset calculation
         * Mimic updateTransparentHeaderOffset() in utilities.js
         */

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();

      (function setHeaderMenuStyle() {
        const headerComponent = document.querySelector('#header-component');
        if (headerComponent) {
          const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
          const overflowList = headerComponent?.querySelector('overflow-list');
          const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
          headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
        }
      })();
    </script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    <footer>
      {% sections 'footer-group' %}
    </footer>

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}




<!-- 浮動按鈕：LINE + Go Top -->
<div class="floating-buttons">

  <!-- LINE Icon -->
<!-- LINE Icon -->
<a href="https://line.me/R/ti/p/@455lfqzf" target="_blank" class="float-btn line-btn" aria-label="LINE">
<img src="https://cdn.shopify.com/s/files/1/0651/9413/1539/files/LINE-New-App-Icon.png?v=1767237533" 
     alt="LINE" width="60" height="60">
</a>

  <!-- Go Top 按鈕 -->
  <button class="float-btn top-btn" id="goTopBtn" aria-label="回到頂部" onclick="window.scrollTo({top:0,behavior:'smooth'})">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"/>
    </svg>
  </button>

</div>

<style>
.floating-buttons {
  position: fixed;
  right: 16px;
  bottom: 24px;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.float-btn {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  border: none;
  box-shadow: 0 2px 8px rgba(0,0,0,0.25);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  text-decoration: none;
}

.float-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 14px rgba(0,0,0,0.3);
}

/* LINE 綠色背景 */
/* 修改後 */
.line-btn {
  background-color: transparent;
  box-shadow: none;
  width: 60px;
  height: 60px;
  padding: 0;
}

.line-btn img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  border-radius: 50%;
  display: block;
}

/* Go Top */
.top-btn {
  background-color: #333;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.top-btn.visible {
  opacity: 1;
  visibility: visible;
}

/* 手機版同步縮小 */
@media (max-width: 768px) {
  .line-btn {
    width: 60px;
    height: 60px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {

  // ② 子選單預載入（避免 hover 延遲）
  customElements.whenDefined('header-menu').then(function () {
    setTimeout(function () {
      document.querySelectorAll('[id^="submenu-"]').forEach(function (sub) {
        sub.dataset.active = '';
      });
    }, 800);
  });


// ④ Go Top 按鈕：滾動超過第一畫面 1/2 才顯示
var topBtn = document.getElementById('goTopBtn');
if (topBtn) {
  window.addEventListener('scroll', function () {
    var halfway = window.innerHeight / 2;  // ← 改成視窗高度的 1/2
    if (window.scrollY > halfway) {
        topBtn.classList.add('visible');
      } else {
        topBtn.classList.remove('visible');
      }
    });
  }

});

// ⑤ 隱藏 Horizon 內建 Scroll down indicator
(function hideBuiltinScrollIndicator() {
  function findAndHide() {
    document.querySelectorAll('*').forEach(function(el) {
      if (el.children.length === 0 && 
          el.textContent.trim().toLowerCase() === 'scroll down') {
        // 隱藏本身及父層容器
        el.style.display = 'none';
        if (el.parentElement) {
          el.parentElement.style.display = 'none';
        }
      }
    });
  }

  // 立即執行 + 延遲確保載入完成
  findAndHide();
  setTimeout(findAndHide, 500);
  setTimeout(findAndHide, 1500);
})();
</script>

<style>
  /* 強制解除主題套在應用程式區塊外的寬度容器限制 */
  .shopify-section:has(.jdgm-carousel-wrapper),
  div[class*="shopify-app-block"],
  .shopify-app-block {
    max-width: 100% !important;
    width: 100% !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
  
  /* 撐開並對齊 Judge.me 到 page-width (1400px) */
  .shopify-section:has(.jdgm-widget) .container,
  .shopify-section:has(.jdgm-widget) .section-content-wrapper,
  .shopify-section:has(.jdgm-widget) .custom-section-content {
    max-width: 100% !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
  
  .jdgm-widget,
  .jdgm-carousel-wrapper,
  .jdgm-carousel {
    max-width: 1400px !important; /* 強制與上方課程格子（標準寬度 1400px）齊寬 */
    width: 100% !important;
    margin: 0 auto !important;
  }
</style>

{% comment %}
  【來趣滑雪】本地端沙盒路由護盾 - 終極模糊比對版
  用途：不看特定的淡旺季字串，直接以「網域 ＋ 全天/半天關鍵字」進行全方位攔截，確保 100% 留在本地端
{% endcomment %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.location.hostname === '127.0.0.1' || window.location.hostname === 'localhost' || window.location.hostname.endsWith('.shopifypreview.com')) {
      console.log('【來趣滑雪終極護盾】全方位網址嗅探防護已啟動。');

      const fixAllLinksFuzzy = () => {
        // 只要網址目的地包含線上官網商品路徑，一律強制捕獲
        const links = document.querySelectorAll('a[href*="://lifechillsnow.com"]');
        
        links.forEach(link => {
          const originalHref = link.href.toLowerCase(); // 轉小寫防呆
          
          // 1. 嗅探全天班 (Fullday)
          if (originalHref.includes('fullday')) {
            // 模糊判定：如果包含 peak (旺季)，導向旺季全天沙盒；否則一律視為淡季全天沙盒
            if (originalHref.includes('peak')) {
              link.href = '/products/test-course-fullday-peak';
            } else {
              link.href = '/products/test-course-fullday-offpeak';
            }
            link.removeAttribute('target');
          }
          
          // 2. 嗅探半天班 (Halfday)
          else if (originalHref.includes('halfday')) {
            // 模糊判定：如果包含 peak (旺季)，導向旺季半天沙盒；否則一律視為淡季半天沙盒
            if (originalHref.includes('peak')) {
              link.href = '/products/test-course-halfday-peak';
            } else {
              link.href = '/products/test-course-halfday-offpeak';
            }
            link.removeAttribute('target');
          }
          
          // 3. 終極安全網：如果既不是 fullday 也不是 halfday（防範業者用了奇怪的縮寫或拼音）
          else {
            console.warn('【護盾警告】發現未知的滑雪商品連結，執行安全強制留置：', link.href);
            // 預設強制留在本地端首頁，防止直接被踢回線上
            link.href = '/'; 
          }
        });
      };

      // 立即執行並設定高效能定時器監聽
      fixAllLinksFuzzy();
      setInterval(fixAllLinksFuzzy, 1000);
    }
  });
</script>

  </body>
</html>
