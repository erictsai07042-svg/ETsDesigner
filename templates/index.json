    "custom_liquid_C8HAxp": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Collection_new",
      "settings": {
        "custom_liquid": "<style>\n.lcs-wrap{padding:48px 24px}\n.lcs-title{font-size:28px;font-weight:600;color:#042C53;margin-bottom:6px;text-align:center}\n.lcs-sub{font-size:14px;color:#888;text-align:center;margin-bottom:36px}\n.lcs-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;max-width:1200px;margin:0 auto}\n@media(max-width:600px){.lcs-grid{grid-template-columns:1fr}}\n.lcs-card{background:#fff;border:1px solid rgba(0,0,0,0.08);border-radius:16px;overflow:hidden;transition:transform .2s,box-shadow .2s}\n.lcs-card:hover{transform:translateY(-3px);box-shadow:0 12px 32px rgba(0,0,0,0.1)}\n.lcs-img{width:100%;aspect-ratio:16/9;position:relative;overflow:hidden}\n.lcs-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s}\n.lcs-card:hover .lcs-img img{transform:scale(1.04)}\n.lcs-badges{position:absolute;top:12px;left:12px;z-index:2}\n.lcs-early{background:#E85D24;color:#fff;font-size:12px;font-weight:500;padding:5px 12px;border-radius:20px;display:inline-block}\n.lcs-season{position:absolute;top:12px;right:12px;font-size:12px;font-weight:500;padding:5px 12px;border-radius:20px;z-index:2}\n.lcs-peak{background:#042C53;color:#B5D4F4}\n.lcs-off{background:#E1F5EE;color:#085041}\n.lcs-overlay{position:absolute;bottom:0;left:0;right:0;height:80px;background:linear-gradient(to top,rgba(4,44,83,0.4),transparent);z-index:1}\n.lcs-body{padding:20px 22px 22px}\n.lcs-name{font-size:20px;font-weight:600;color:#1a1a18;margin-bottom:4px}\n.lcs-desc{font-size:13px;color:#888;margin-bottom:6px}\n.lcs-season-range{font-size:12px;color:#185FA5;background:#E6F1FB;padding:3px 10px;border-radius:20px;display:inline-block;margin-bottom:14px}\n.lcs-hr{border:none;border-top:1px solid rgba(0,0,0,0.07);margin:0 0 14px}\n.lcs-price-table{width:100%;margin-bottom:14px;border-collapse:collapse}\n.lcs-price-table th{font-size:12px;color:#888;font-weight:400;text-align:left;padding:0 0 6px;border-bottom:1px solid rgba(0,0,0,0.06)}\n.lcs-price-table th:last-child{text-align:right}\n.lcs-price-table td{padding:8px 0;border-bottom:1px solid rgba(0,0,0,0.04);vertical-align:middle}\n.lcs-price-table tr:last-child td{border-bottom:none}\n.lcs-pax{font-size:14px;color:#444}\n.lcs-pax-sub{font-size:11px;color:#aaa;display:block}\n.lcs-price-cell{text-align:right}\n.lcs-orig{font-size:12px;color:#bbb;text-decoration:line-through;display:block;line-height:1.2}\n.lcs-new{font-size:18px;font-weight:600;color:#042C53;line-height:1.4}\n.lcs-unit{font-size:11px;color:#888;font-weight:400}\n.lcs-dl{font-size:12px;color:#aaa;margin-bottom:16px}\n.lcs-dl b{color:#E85D24;font-weight:500}\n.lcs-btn{width:100%;padding:14px;border-radius:10px;border:none;font-size:15px;font-weight:500;cursor:pointer;background:#E85D24;color:#fff;letter-spacing:0.02em;transition:background .15s,transform .1s;display:flex;align-items:center;justify-content:center;gap:8px;text-decoration:none}\n.lcs-btn:hover{background:#C04820;transform:scale(1.01)}\n.lcs-btn:active{transform:scale(0.97)}\n.lcs-arr{display:inline-block;transition:transform .2s}\n.lcs-btn:hover .lcs-arr{transform:translateX(4px)}\n</style>\n\n<div class=\"lcs-wrap\">\n  <div class=\"lcs-title\">課程預訂</div>\n  <div class=\"lcs-sub\">早鳥優惠進行中 · 優惠至 <b style=\"color:#E85D24\">2026/6/30</b> 止，享 85 折優惠</div>\n  <div class=\"lcs-grid\">\n\n    <div class=\"lcs-card\">\n      <div class=\"lcs-img\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0651/9413/1539/files/IMG_2690.jpg?v=1777381828\" alt=\"教練在富良野纜車旁滑行\">\n        <div class=\"lcs-badges\"><span class=\"lcs-early\">早鳥優惠</span></div>\n        <span class=\"lcs-season lcs-peak\">旺季</span>\n        <div class=\"lcs-overlay\"></div>\n      </div>\n      <div class=\"lcs-body\">\n        <div class=\"lcs-name\">全天課（6 小時）</div>\n        <div class=\"lcs-desc\">富良野・神居・星野滑雪場　｜　含 1 小時午休</div>\n        <span class=\"lcs-season-range\">旺季：12/16 ～ 2/28</span>\n        <hr class=\"lcs-hr\">\n        <table class=\"lcs-price-table\">\