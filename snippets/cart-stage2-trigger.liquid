{% comment %}
  Plan B 觸發器：購物車頁載入/更新時，檢查有沒有課程商品還沒補 Stage 2/3 資料，有的話跳出 Modal。
  只負責「何時該顯示」，「顯示什麼」完全交給 assets/course-stage2-module.js。
  2026-08-12 確認：這是長期架構，不是過渡方案。Stage 3 技術上只能實作在購物車頁（BTA widget
  不提供在單一產品頁、加入購物車前收集加購資料的機制），送出後跳轉購物車頁完成 Stage 3 是
  最終形態，不會被「商品頁不跳轉」的版本取代，這個檔案不會被刪除。詳見 PROGRESS.md 決策 3。
{% endcomment %}
<script src="{{ 'course-stage2-module.js' | asset_url }}" defer></script>
<div id="cart-stage2-trigger-mount"></div>
<script>
(function () {
  var STAGE2_DONE_KEY = '_stage2_completed';
  var ATTENDEE_COUNT_KEY = '實際參加人數';

  function isCourseItem(item) {
    return item.product_type === 'Course' || (item.handle && item.handle.indexOf('course') > -1);
  }

  function findItemNeedingStage2(cart) {
    return cart.items.filter(function (item) {
      return isCourseItem(item) && !item.properties[STAGE2_DONE_KEY];
    })[0];
  }

  /* 實際參加人數要從 BTA Booking Field「實際參加人數」寫入的 line item property 讀，
     不能用 Shopify 的 quantity——課程商品是綁定人數級距的套裝價（例如「1~2人」「3~4人」
     同級距內價格固定），quantity 恆為 1，沒辦法用來推算實際到場人數。
     舊訂單／測試流程若還沒走過這個新欄位，預設顯示 1 組並記錄警告，方便日後排查，而非直接報錯或空白。 */
  function getAttendeeCount(item) {
    var raw = item.properties[ATTENDEE_COUNT_KEY];
    var count = parseInt(raw, 10);
    if (!raw || isNaN(count) || count < 1) {
      console.warn('[CourseStage2] 購物車項目缺少「' + ATTENDEE_COUNT_KEY + '」欄位資料，預設顯示 1 組加購選項。line item key: ' + item.key);
      return 1;
    }
    return count;
  }

  function checkAndTrigger() {
    var mount = document.getElementById('cart-stage2-trigger-mount');
    if (!mount || !window.CourseStage2Module) return;

    fetch('/cart.js')
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var targetItem = findItemNeedingStage2(cart);
        if (!targetItem) {
          mount.innerHTML = '';
          return;
        }
        window.CourseStage2Module.renderStage2Form(mount, {
          attendeeCount: getAttendeeCount(targetItem),
          productTitle: targetItem.product_title,
          /* 課程原價直接讀購物車該筆 line item 現有金額（分為單位，Shopify /cart.js 慣例），
             優先用 final_line_price（含 cart 層折扣分攤），沒有才退回 line_price / price——
             不寫死任何金額，價格調整時這裡不需要跟著改。 */
          coursePriceCents: targetItem.final_line_price != null ? targetItem.final_line_price :
            (targetItem.line_price != null ? targetItem.line_price : targetItem.price),
          onSubmit: function (properties) {
            properties[STAGE2_DONE_KEY] = 'true';
            window.CourseStage2Module.writeCourseFormDataToCart(targetItem.key, properties).then(function () {
              checkAndTrigger();
            });
          },
          onSkip: function () {
            var skipProps = {};
            skipProps[STAGE2_DONE_KEY] = 'skipped';
            window.CourseStage2Module.writeCourseFormDataToCart(targetItem.key, skipProps).then(function () {
              checkAndTrigger();
            });
          },
        });
      });
  }

  document.addEventListener('DOMContentLoaded', checkAndTrigger);
  document.addEventListener('cart:update', checkAndTrigger);
  if (document.readyState !== 'loading') checkAndTrigger();
})();
</script>
