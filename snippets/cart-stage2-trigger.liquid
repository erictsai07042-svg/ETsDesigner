{% comment %}
  Plan B 觸發器：購物車頁載入/更新時，檢查有沒有課程商品還沒補 Stage 2/3 資料，有的話跳出 Modal。
  只負責「何時該顯示」，「顯示什麼」完全交給 assets/course-stage2-module.js。
  2026-08-12 確認：這是長期架構，不是過渡方案。Stage 3 技術上只能實作在購物車頁（BTA widget
  不提供在單一產品頁、加入購物車前收集加購資料的機制），送出後跳轉購物車頁完成 Stage 3 是
  最終形態，不會被「商品頁不跳轉」的版本取代，這個檔案不會被刪除。詳見 PROGRESS.md 決策 3。
{% endcomment %}
{%- liquid
  # 課程商品判斷跟 blocks/buy-buttons.liquid 用同一套 tag 邏輯（halfday/fullday，含
  # test- 前綴跟 hoshino 系列），不能沿用原本 item.handle.indexOf('course') 那個判斷——
  # 2026-08-18 發現正式課程商品 handle 都不含「course」字串，這個判斷從未在正式商品上
  # 生效過。/cart.js 的 line item 本身沒有 tags 欄位，沒辦法在前端 JS 直接查，這裡改成
  # 在 Liquid 端（cart.items[n].product 有完整 tags）先算出符合的 product_id 清單，
  # 傳給下面的 JS 查表。這份清單只在頁面載入當下算一次：這個檔案的送出流程只會改動
  # 既有購物車項目的 properties，不會在同一頁面生命週期內新增全新的課程商品項目
  # （BTA 加入購物車一律會整頁導向 /cart，course_product_ids 屆時會跟著整頁重新計算），
  # 不需要即時重算。
  assign course_product_ids = ''
  for item in cart.items
    assign item_tags_string = item.product.tags | join: ','
    if item.product.type == 'Course' or item_tags_string contains 'halfday' or item_tags_string contains 'fullday'
      assign course_product_ids = course_product_ids | append: item.product_id | append: ','
    endif
  endfor
-%}
<script type="module" src="{{ 'course-stage2-module.js' | asset_url }}"></script>
<div id="cart-season-mismatch-warning"></div>
<div id="cart-stage2-trigger-mount"></div>
<script>
(function () {
  var STAGE2_DONE_KEY = '_stage2_completed';
  var ATTENDEE_COUNT_KEY = '實際參加人數';
  var COURSE_PRODUCT_IDS = '{{ course_product_ids }}'.split(',').filter(Boolean).map(Number);
  // 開發指令規格順序6 方向性修正（2026-08-27）：原本用商品 resort-furano 標籤判斷
  // 是誤判資料模型——實際上客人是在 Stage 2 BTA Booking Field 下拉選單裡選雪場，
  // 不是商品本身帶什麼標籤。這個欄位寫進購物車的 property key 不是表單原始 HTML
  // 的 name 屬性，而是 BTA Booking Field 設定當下的顯示 Label 文字本身——這代表
  // Eric 之後如果在 BTA 後台編輯這個欄位的名稱/選項（例如清理「測試」字首、修正
  // 選項文字），property key 會直接跟著變，程式碼這裡的常數就會失效。
  //
  // 2026-09-03 晚間查證+修復：Eric 反映富良野 Stage3 裝備/住宿加購卡片消失，查證
  // 發現正是上述情況——Eric 稍早進 BTA 後台把「測試」字首拿掉、同時把過時的雪場
  // 選項文字（旭川神居/佐幌）修正成正確名稱（旭川/十勝），這個欄位的 Label 本身也
  // 從「滑雪場」變成「雪場區域」。已用 test-course-fullday-peak／test-course-halfday-peak
  // 兩個正式商品各自走一次真實 BTA 預約流程、查 /cart.js 直接確認新的真實 key，
  // 不是用猜的。8/27〜8/29 查證時的舊 key（測試版「(測試) 滑雪場」、正式版
  // 「滑雪場」）繼續保留在 || 鏈最後面當 fallback——不刪除是因為不確定 widget 111783
  // （非星號的舊正式商品）那邊的欄位有沒有被同一次清理動到，留著才不會讓舊商品的
  // 判斷跟著壞掉，何況多一個 fallback key 幾乎零成本。單一 line item 不會同時命中
  // 兩個以上的 key，用 || 讀取互斥安全；全部都讀不到時自然是 undefined === '富良野'
  // → false，維持「未知情況不顯示」的 fail-safe 方向。
  var RESORT_KEY_CURRENT = '雪場區域'; // 2026-09-03 起的真實 key（widget 124456，已實測確認）
  var RESORT_KEY_PROD = '滑雪場'; // 8/27~9/3 期間的正式版 key，保留 fallback
  var RESORT_KEY_TEST = '(測試) 滑雪場'; // 8/27~9/3 期間的測試版 key，保留 fallback
  var TARGET_RESORT = '富良野';

  /* 任務二（2026-08-29）：Stage 3 原本另外做了一個可勾選的「同行人員中有兒童」checkbox，
     業主確認這跟 Stage 2 既有的「是否有 6~12 歲兒童同行」BTA Booking Field 是重複詢問，
     改成 Stage 3 直接讀 Stage 2 這個欄位的答案，答案是「有」才唯讀顯示一行提示，不用
     再讓客人操作一次。

     2026-09-03 晚間修復：跟「雪場」欄位同一次 BTA 後台清理連帶弄壞——Eric 拿掉這個
     欄位的「(測試) 」字首後，兩邊環境的 key 現在統一變成沒有字首、但符號維持原本
     測試版的半形寫法（波浪號 `~`、右括號 `)` 都是半形）。已用 test-course-fullday-peak
     真實送出一次 BTA 表單、查 /cart.js 直接確認新 key 的每個字元（含全半形符號），
     不是憑印象照抄。8/29 查證時的兩個舊 key 一樣保留在 || 鏈最後面當 fallback，
     理由跟「雪場」欄位一致（不確定 widget 111783 有沒有被連帶影響）。 */
  var CHILD_COMPANION_KEY_CURRENT = '是否有 6~12 歲兒童？（每組最多接受 1 位兒童同行)'; // 2026-09-03 起的真實 key（已實測確認，波浪號/右括號皆半形，無「(測試) 」字首）
  var CHILD_COMPANION_KEY_PROD = '是否有 6～12 歲兒童？（每組最多接受 1 位兒童同行）'; // 8/27~9/3 期間的正式版 key，保留 fallback
  var CHILD_COMPANION_KEY_TEST = '(測試) 是否有 6~12 歲兒童？（每組最多接受 1 位兒童同行)'; // 8/27~9/3 期間的測試版 key，保留 fallback

  function isCourseItem(item) {
    return item.product_type === 'Course' || COURSE_PRODUCT_IDS.indexOf(item.product_id) > -1;
  }

  // 開發指令規格順序6（方向性修正）：裝備租賃／住宿加購是否顯示，改看 Stage 2
  // 雪場欄位的答案是否為「富良野」，不再看商品標籤。
  function isFuranoItem(item) {
    var resort = item.properties[RESORT_KEY_CURRENT] || item.properties[RESORT_KEY_PROD] || item.properties[RESORT_KEY_TEST];
    return resort === TARGET_RESORT;
  }

  // 任務二：Stage 3 兒童同行提示是否顯示，改看 Stage 2「是否有 6~12 歲兒童同行」答案。
  function hasChildCompanion(item) {
    var answer = item.properties[CHILD_COMPANION_KEY_CURRENT] || item.properties[CHILD_COMPANION_KEY_PROD] || item.properties[CHILD_COMPANION_KEY_TEST];
    return answer === '有';
  }

  /* 2026-09-04（緊急修復）：教練/裝備加購費用重複計費——根因是 addRealGearLineItems()
     成功呼叫 /cart/add.js 後會 dispatch CartUpdateEvent（事件名稱就是 'cart:update'，
     見 assets/events.js ThemeEvents.cartUpdate），而下面 document.addEventListener
     ('cart:update', checkAndTrigger) 會接住這個事件重新檢查購物車。2026-09-01 那次把
     「加裝備/教練」跟「寫 _stage2_completed 標記」改成依序執行（先加購、才標記完成）之後，
     這個時序變成固定：addRealGearLineItems() 完成當下，_stage2_completed 必然還沒寫入，
     連帶讓這裡的 cart:update 監聽器在標記完成「之前」就搶先重新觸發 checkAndTrigger()，
     對同一筆還在送出中的課程項目重新彈出 Modal——如果使用者這時候又送出一次，教練/裝備
     就會被真的加購兩次（教練費固定 quantity 1，兩次送出＝兩筆各自 quantity 1 的 line
     item，合計金額變兩倍）。這不是機率性的，是今天那個依序修復必然會造成的副作用。

     修法：用 pendingSubmissionKeys 記錄「正在送出中、還沒收到最終結果」的 line item key，
     findItemNeedingStage2() 排除這些 key，讓中途觸發的 checkAndTrigger() 不會對同一筆
     還在處理中的項目重新彈出 Modal。等 onSubmit 的 promise chain 真正結束（成功或失敗）
     才解鎖——失敗時要解鎖，因為原本的設計就是要讓客人能重新送出重試，不能因為多了這個鎖
     反而卡死重試路徑。 */
  var pendingSubmissionKeys = {};

  function findItemNeedingStage2(cart) {
    return cart.items.filter(function (item) {
      return isCourseItem(item) && !item.properties[STAGE2_DONE_KEY] && !pendingSubmissionKeys[item.key];
    })[0];
  }

  /* 2026-09-01（緊急修復）：淡季商品能選到旺季日期、價格沒有跟著變的漏洞。
     根因已查證：BTA 後台每個課程商品（無論淡季/旺季）的可預訂日期範圍（mindate/
     maxdate）都是「距今幾天」的通用區間，完全沒有依商品淡旺季排除對方的日期；
     BTA 的「Seasonal Rates」原生功能只支援 Tour/Activity 這個 booking type，我們
     用的是 Rentals（product profile），用不了；「Blackout」功能雖然原生支援
     依商品＋日期區間封鎖，但要進 BTA 後台手動設定（已回報 Eric，尚未設定），
     且就算設定了也只擋日曆 UI，不會回頭修正「BTA 完成流程當下已經把錯誤商品/
     價格寫進購物車」這件事——所以無論 BTA 後台設不設，購物車這一層的驗證都需要。
     這裡在購物車頁對每個課程 line item 的 Start 日期跟商品淡旺季比對，不符合就
     擋結帳＋顯示明確提示，不静默放行也不自動改價（改價需要換 variant，屬於
     另一個風險更高的操作，這次先用「擋結帳＋引導聯繫」止血）。
     季節區間直接沿用 snippets/course-booking-form.liquid 靜態提示文字、
     templates/page.course-introduction.json 費用說明已經公告給客人的同一組
     2026-2027 雪季日期，不是另外定義的新資料——之後雪季日期更新時，這裡要跟
     那两處一起同步修改。 */
  var SEASON_RANGES = {
    peak: [[new Date(2026, 11, 16), new Date(2027, 1, 28)]],
    offpeak: [
      [new Date(2026, 11, 5), new Date(2026, 11, 15)],
      [new Date(2027, 2, 1), new Date(2027, 3, 30)],
    ],
  };
  /* 2026-09-01（第三層防護）：淡季∪旺季這兩組區間剛好首尾相接（12/5~12/15、
     12/16~2/28、3/1~4/30 三段連續無縫隙），聯集起來就是單一連續區間
     2026/12/5～2027/4/30。這裡額外做「完全不在整個雪季營業期間內」的檢查
     （例如 9 月、10 月、11 月，或 5 月以後），不管商品是淡季版還是旺季版，
     只要選到這個區間以外的日期一律擋——這是比對「商品淡旺季 vs. 選的日期」
     更根本的一層驗證，不依賴 BTA 後台的日期限制設定有沒有正確配置（BTA 後台
     124456 這個 widget 目前完全沒設定日期限制，客人能選到 9 月這種完全不在
     營業期間的日期，就是靠這層擋下來，不等 BTA 後台設定完成才生效）。 */
  var WHOLE_SEASON_RANGE = [new Date(2026, 11, 5), new Date(2027, 3, 30)];

  // 商品淡旺季無法用 tags 判斷（實測確認：同一組 halfday/fullday tag 底下，淡季版
  // 跟旺季版的 tags 完全相同，差異只在 handle），改用 handle substring 比對，
  // 涵蓋測試/正式兩種命名慣例（test-course-fullday-offpeak／fullday-class-off-season
  // 皆含 off-season 或 offpeak；旺季版 handle 皆含 peak，但要先排除掉「offpeak」
  // 字串本身也含 peak 這個陷阱，所以離峰判斷要放在旺季判斷之前）。
  function getProductSeason(item) {
    var handle = (item.handle || '').toLowerCase();
    if (handle.indexOf('off-season') > -1 || handle.indexOf('offpeak') > -1) return 'offpeak';
    if (handle.indexOf('peak') > -1) return 'peak';
    return null;
  }

  // BTA 寫入 Start property 的格式固定是 MM/DD/YYYY（英文格式，跟後台語系無關，
  // 已用 PROGRESS.md 記錄過的真實端對端流程結果核對過）。
  function parseBtaStartDate(value) {
    if (!value) return null;
    var parts = String(value).split('/');
    if (parts.length !== 3) return null;
    var month = parseInt(parts[0], 10);
    var day = parseInt(parts[1], 10);
    var year = parseInt(parts[2], 10);
    if (!month || !day || !year) return null;
    return new Date(year, month - 1, day);
  }

  function isDateInRanges(date, ranges) {
    return ranges.some(function (range) {
      return date >= range[0] && date <= range[1];
    });
  }

  function findSeasonMismatches(cart) {
    return cart.items
      .filter(isCourseItem)
      .map(function (item) {
        var season = getProductSeason(item);
        var startDate = parseBtaStartDate(item.properties.Start);
        if (!season || !startDate) return null;
        // 第三層防護先判斷：完全不在整個雪季營業期間內（例如 9 月），不管商品淡旺季，
        // 一律擋下，不用再往下比對是不是「選錯季節」（反正也不是任何一種季節）。
        if (!isDateInRanges(startDate, [WHOLE_SEASON_RANGE])) {
          return { item: item, season: season, startDate: startDate, reason: 'out-of-season' };
        }
        var wrongRanges = season === 'offpeak' ? SEASON_RANGES.peak : SEASON_RANGES.offpeak;
        if (isDateInRanges(startDate, wrongRanges)) {
          return { item: item, season: season, startDate: startDate, reason: 'wrong-season' };
        }
        return null;
      })
      .filter(Boolean);
  }

  function formatDate(date) {
    return date.getFullYear() + '/' + (date.getMonth() + 1) + '/' + date.getDate();
  }

  /* 實測發現：Horizon 主題的購物車元件會在 cart:update 前後自己重新同步/覆寫
     #checkout 按鈕的 disabled 屬性（推測是它自己根據購物車數量/驗證狀態管理的
     邏輯），單靠設定 disabled 不可靠，會被之後某個時間點悄悄改回 false。
     改用三層防護：(1) disabled 屬性照設，能生效算賺到；(2) 整個 .cart__ctas
     容器蓋 pointer-events:none，擋住真人點擊；(3) 下面 capture-phase 的 submit
     監聽（跟 course-booking-form.liquid「實際參加人數」驗證同一套已驗證有效的
     攔截模式），擋住任何形式的表單送出（含鍵盤 Enter 或其他程式觸發的 submit），
     三者互為備援，不依賴單一機制。 */
  var checkoutBlockedByMismatch = false;

  function setCheckoutBlocked(blocked) {
    checkoutBlockedByMismatch = blocked;
    var checkoutBtn = document.getElementById('checkout');
    if (checkoutBtn) checkoutBtn.disabled = blocked;
    var ctas = document.querySelector('.cart__ctas');
    if (ctas) {
      if (blocked) {
        ctas.style.setProperty('opacity', '0.4', 'important');
        ctas.style.setProperty('pointer-events', 'none', 'important');
      } else {
        ctas.style.removeProperty('opacity');
        ctas.style.removeProperty('pointer-events');
      }
    }
  }

  document.addEventListener('submit', function (event) {
    if (checkoutBlockedByMismatch && event.target && event.target.id === 'cart-form') {
      event.preventDefault();
      event.stopPropagation();
      var mount = document.getElementById('cart-season-mismatch-warning');
      if (mount) mount.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }, true);

  function renderSeasonMismatchWarning(mismatches) {
    var mount = document.getElementById('cart-season-mismatch-warning');
    if (!mount) return;
    setCheckoutBlocked(mismatches.length > 0);
    if (mismatches.length === 0) {
      mount.innerHTML = '';
      return;
    }
    mount.innerHTML = '';
    var box = document.createElement('div');
    box.className = 'season-mismatch-warning';

    var title = document.createElement('p');
    title.className = 'season-mismatch-warning__title';
    title.textContent = '訂單日期與商品季節不符，暫時無法結帳';
    box.appendChild(title);

    mismatches.forEach(function (mismatch) {
      var line = document.createElement('p');
      line.className = 'season-mismatch-warning__item';
      if (mismatch.reason === 'out-of-season') {
        line.textContent =
          '「' + mismatch.item.product_title + '」選擇的日期是 ' + formatDate(mismatch.startDate) +
          '，這個日期不在雪季營業期間內（營業期間：2026/12/5～2027/4/30），無法預訂。';
      } else {
        var seasonLabel = mismatch.season === 'offpeak' ? '淡季優惠商品' : '旺季商品';
        var wrongSeasonLabel = mismatch.season === 'offpeak' ? '旺季' : '淡季';
        line.textContent =
          '「' + mismatch.item.product_title + '」（' + seasonLabel + '）選擇的日期是 ' +
          formatDate(mismatch.startDate) + '，這個日期屬於' + wrongSeasonLabel + '期間，價格可能不正確。';
      }
      box.appendChild(line);
    });

    var desc = document.createElement('p');
    desc.className = 'season-mismatch-warning__desc';
    desc.textContent = '請點擊下方按鈕聯繫我們協助確認訂單與正確價格，或重新選擇符合日期的課程商品。';
    box.appendChild(desc);

    var btn = document.createElement('a');
    btn.href = 'https://line.me/R/ti/p/@455lfqzf';
    btn.target = '_blank';
    btn.rel = 'noopener noreferrer';
    btn.className = 'season-mismatch-warning__btn';
    btn.textContent = '加 LINE 聯繫我們';
    box.appendChild(btn);

    mount.appendChild(box);
  }

  /* 實際參加人數要從 BTA Booking Field「實際參加人數」寫入的 line item property 讀，
     不能用 Shopify 的 quantity——課程商品是綁定人數級距的套裝價（例如「1~2人」「3~4人」
     同級距內價格固定），quantity 恆為 1，沒辦法用來推算實際到場人數。
     舊訂單／測試流程若還沒走過這個新欄位，預設顯示 1 組並記錄警告，方便日後排查，而非直接報錯或空白。 */
  function getAttendeeCount(item) {
    var raw = item.properties[ATTENDEE_COUNT_KEY];
    var count = parseInt(raw, 10);
    if (!raw || isNaN(count) || count < 1) {
      console.warn('[CourseStage2] 購物車項目缺少「' + ATTENDEE_COUNT_KEY + '」欄位資料，預設顯示 1 組加購選項。line item key: ' + item.key);
      return 1;
    }
    return count;
  }

  function checkAndTrigger() {
    var mount = document.getElementById('cart-stage2-trigger-mount');
    if (!mount || !window.CourseStage2Module) return;

    fetch('/cart.js')
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var targetItem = findItemNeedingStage2(cart);
        if (!targetItem) {
          mount.innerHTML = '';
          return;
        }
        window.CourseStage2Module.renderStage2Form(mount, {
          attendeeCount: getAttendeeCount(targetItem),
          productTitle: targetItem.product_title,
          showGearAndHotel: isFuranoItem(targetItem),
          hasChildCompanion: hasChildCompanion(targetItem),
          /* 課程原價直接讀購物車該筆 line item 現有金額（分為單位，Shopify /cart.js 慣例），
             優先用 final_line_price（含 cart 層折扣分攤），沒有才退回 line_price / price——
             不寫死任何金額，價格調整時這裡不需要跟著改。 */
          coursePriceCents: targetItem.final_line_price != null ? targetItem.final_line_price :
            (targetItem.line_price != null ? targetItem.line_price : targetItem.price),
          onSubmit: function (properties, realGearCartItems) {
            properties[STAGE2_DONE_KEY] = 'true';
            // 2026-09-04 緊急修復：送出中先鎖住這個 line item key，見上方
            // pendingSubmissionKeys 的完整說明——避免 addRealGearLineItems() 觸發的
            // cart:update 事件在標記完成前搶先重新彈出同一筆的 Modal 造成重複加購。
            pendingSubmissionKeys[targetItem.key] = true;
            /* 2026-09-01（緊急修復）：原本這裡用 Promise.all 讓「寫課程 line item
               properties」跟「呼叫 /cart/add.js 加裝備/教練 line item」兩個購物車
               寫入動作同時平行送出。實測直接重現過這樣做的問題：對同一個購物車
               session 平行送出兩個會修改購物車的請求，Shopify 後端偶爾會讓其中一個
               寫入被悄悄蓋掉/遺失（10 次乾淨測試裡發生 2 次），而且原本兩段程式碼
               都沒檢查 response.ok 就直接 .json()，任何一邊失敗（含這種平行寫入
               衝突、或單純網路/暫時性錯誤）都會變成無聲失敗：客人畫面上 Modal
               關閉、看起來完成了，購物車卻可能少了教練/裝備的真實計費 line item，
               或者少了 properties（連帶少了 _stage2_completed 標記）——兩種情況
               哪個會發生，取決於哪邊剛好在那次衝突中輸掉，不是固定always同一邊，
               這正好解釋了「有時候有、有時候沒有」的間歇性表現，教練與六項裝備都
               共用這同一段程式碼，不是教練專屬的問題。

               修法：兩件事改成**依序**執行，不再平行——先呼叫 addRealGearLineItems()
               確認裝備/教練真的加入購物車，成功後才呼叫 writeCourseFormDataToCart()
               把 _stage2_completed 標記寫上去。這個順序刻意設計成「後面才標記完成」：
               如果裝備/教練加入失敗，properties（含完成標記）就不會被寫入，下次
               checkAndTrigger() 讀到這筆訂單還沒完成 Stage2，會自動重新彈出 Modal
               讓客人重試，不會卡在「看起來完成、實際上遺失資料」的無聲失敗狀態。
               另外兩段函式現在都會在收到非 200 回應時 throw，這裡用 .catch() 接住，
               明確告知客人並記錄到 console，不再讓例外悄悄消失。 */
            window.CourseStage2Module.addRealGearLineItems(realGearCartItems)
              .then(function () {
                return window.CourseStage2Module.writeCourseFormDataToCart(targetItem.key, properties);
              })
              .then(function () {
                // 成功後才解鎖：_stage2_completed 這時已經寫入，就算解鎖後 cart:update
                // 又觸發一次 checkAndTrigger()，也會正確判斷這筆項目已完成、不會重新彈出。
                delete pendingSubmissionKeys[targetItem.key];
                checkAndTrigger();
              })
              .catch(function (err) {
                console.error('[CourseStage2] 加購送出失敗，_stage2_completed 未標記，下次會重新顯示 Modal 讓客人重試：', err);
                alert('加購項目送出失敗，請重新嘗試一次。若持續發生，請透過 LINE 聯繫我們協助確認訂單。');
                // 失敗也要解鎖：維持原本「失敗後客人可以重新送出重試」的設計，不能讓鎖
                // 卡死這筆項目、變成永遠不會再彈出 Modal。
                delete pendingSubmissionKeys[targetItem.key];
                checkAndTrigger();
              });
          },
          onSkip: function () {
            var skipProps = {};
            skipProps[STAGE2_DONE_KEY] = 'skipped';
            window.CourseStage2Module.writeCourseFormDataToCart(targetItem.key, skipProps).then(function () {
              checkAndTrigger();
            });
          },
        });
      });
  }

  /* 跟 checkAndTrigger() 分開、獨立的 fetch + 觸發條件：季節比對不依賴
     window.CourseStage2Module（純日期比對，不需要那個模組），也不該因為
     Stage2 Modal 還沒載入完成就被連帶擋住——結帳按鈕該不該擋，優先權比
     裝備加購 Modal 高，早一步能判斷就該早一步擋。 */
  function checkSeasonMismatch() {
    var mount = document.getElementById('cart-season-mismatch-warning');
    if (!mount) return;
    fetch('/cart.js')
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        renderSeasonMismatchWarning(findSeasonMismatches(cart));
      });
  }

  document.addEventListener('DOMContentLoaded', checkAndTrigger);
  document.addEventListener('cart:update', checkAndTrigger);
  document.addEventListener('DOMContentLoaded', checkSeasonMismatch);
  document.addEventListener('cart:update', checkSeasonMismatch);
  if (document.readyState !== 'loading') {
    checkAndTrigger();
    checkSeasonMismatch();
  }
})();
</script>

