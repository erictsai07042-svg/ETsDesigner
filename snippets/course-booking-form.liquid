<script>
(function() {
  /* 動態偵測 BTA Inline widget（Snow class booking）是否已成功掛載進 #bta-product-widget。
     BTA 自己注入的 CSS 會把 .product-form-buttons（STEP UI 外層容器）設 display:none，
     等偵測到 widget 內部出現 <iframe> 子節點（代表已成功掛載）才把它改回可見，
     避免在頁面載入當下就搶著顯示、打亂 BTA 判斷「初始應為隱藏狀態」的時機。 */
  /* 注意：BTA 可能不是原地修改 #bta-product-widget，而是整個移除舊節點、建立新節點取代它，
     所以每次都要重新用 getElementById 現查，不能依賴一開始捕捉的節點參照（會變成死節點）。
     監聽對象改成不會被 BTA 替換掉的穩定父層容器。 */
  const watchContainer = document.getElementById('booking-current-date-picker') || document.body;
  const revealStepUI = () => {
    const pfb = document.querySelector('.product-form-buttons');
    if (pfb) {
      pfb.style.setProperty('display', 'flex', 'important');
      pfb.style.setProperty('flex-direction', 'column', 'important');
    }
  };

  /* 決策 6（2026-08-09 因應 Stage1 兩欄並排改版重寫）：把 BTA 日曆 widget 用 position:absolute
     視覺疊加到 .course-calendar-column 這個「錨點容器」正上方，完全不動 DOM 樹順序、不改任何
     元素的 display 模式（決策 4-2、決策 5 都已證實：動 DOM 順序或 <form> 的 display 這條路徑
     對 BTA 的插入行為無效或風險過高）。

     跟舊版（單欄，日曆疊在 Hero banner 下方）的差異：
       - 舊版用「hero 高度」當 widget 的 top 基準、left:0/width:100% 佔滿整個 form 寬度。
       - 這次日曆改跟「您選擇的方案資訊」卡片並排，widget 只能佔左欄寬度，改成直接量測
         .course-calendar-column（一個留在正常文件流裡的容器，會隨 Hero banner 高度變化、
         RWD 斷點正確地跟著跑到對的位置）相對於 form 的座標，不用再自己另外算 hero 高度。
       - 進度條這次「不搬離原本巢狀位置」，改成留在 .course-calendar-column 正常文件流裡
         （不再是 form 的直接子層），所以：(a) 不會被 BTA 的白名單隱藏規則命中，不需要再
         強制設 display/position；(b) 不需要 insertBefore 搬動；(c) 它的高度直接撐開
         .course-calendar-column 的自然高度，widget 的 top 只要接在它下面即可。
       - 舊版用「widget 高度」回頭設 .course-main-layout-grid 的 margin-top，幫下面內容
         預留空間。這次改成讓 .course-calendar-column 自己的高度動態同步「進度條高度 + 間距
         + widget 高度」，Grid/Flex 版面會自動根據這個高度正確保留空間，不需要再手動算
         margin-top、也不用再管「下面內容現在是誰」（跟目標元素解耦，更不容易再壞掉）。
     所有數字都不寫死，用 ResizeObserver 持續監聽，數字改變就即時重算。 */
  const BAR_TO_WIDGET_GAP = 16; // 必須跟 CSS 裡 .bta-step-progress-bar 的 margin-bottom 一致
  const positionWidgetOverlay = () => {
    const form = document.querySelector('form.shopify-product-form');
    const calendarColumn = document.querySelector('.course-calendar-column');
    const widget = document.getElementById('bta-product-widget');
    const progressBar = document.getElementById('bta-step-progress-bar');
    if (!form || !calendarColumn || !widget || !window.ResizeObserver) return;

    form.style.setProperty('position', 'relative', 'important');

    const applyWidgetPosition = () => {
      const colRect = calendarColumn.getBoundingClientRect();
      const formRect = form.getBoundingClientRect();
      const barRect = progressBar ? progressBar.getBoundingClientRect() : null;
      const left = colRect.left - formRect.left;
      const top = (barRect ? barRect.bottom : colRect.top) - formRect.top + (barRect ? BAR_TO_WIDGET_GAP : 0);

      widget.style.setProperty('position', 'absolute', 'important');
      widget.style.setProperty('left', left + 'px', 'important');
      widget.style.setProperty('width', colRect.width + 'px', 'important');
      widget.style.setProperty('z-index', '5', 'important');
      widget.style.setProperty('top', top + 'px', 'important');
    };
    applyWidgetPosition();

    /* 實測發現：BTA 自己顯示/隱藏 widget 時是用 setAttribute('style', ...) 整個覆蓋 style
       屬性（不是疊加），會把我們設的 position/left/width/z-index 一起洗掉，只留下它自己要的
       display。用 MutationObserver 盯緊 widget 自己的 style attribute，一旦被 BTA 改動、
       發現我們要的 position:absolute 不見了，立刻補回去。判斷式本身能防止無限迴圈：補回去之後
       widget.style.position 會變回 'absolute'，下一次觸發時條件不成立就不會再重覆呼叫。 */
    const styleGuard = new MutationObserver(() => {
      if (widget.style.position !== 'absolute') {
        applyWidgetPosition();
      }
    });
    styleGuard.observe(widget, { attributes: true, attributeFilter: ['style'] });

    /* .course-calendar-column 本身沒有變寬變高就不會觸發 ResizeObserver，但 Hero banner
       高度變化（例如標題折成兩行）只會讓 calendarColumn 的「Y 座標」往下推、不會改變它
       自己的尺寸，ResizeObserver 抓不到這種純位移——所以還是要單獨觀察 hero，高度一變就
       重新算一次（重新讀 colRect 的當下數值，不是用 hero 高度直接參與公式）。 */
    const hero = document.querySelector('.course-hero-banner');
    if (hero) new ResizeObserver(applyWidgetPosition).observe(hero);
    new ResizeObserver(applyWidgetPosition).observe(calendarColumn);
    if (progressBar) new ResizeObserver(applyWidgetPosition).observe(progressBar);

    /* .course-calendar-column 需要動態撐高到「進度條高度 + 間距 + widget 實際高度」，
       Grid/Flex 版面才會正確幫右欄卡片對齊、也才會讓下一個區塊接在正確位置——完全交給
       正常文件流自動處理，不需要再手動指定「下一個元素是誰、要補多少 margin-top」。 */
    const updateColumnHeight = () => {
      const barHeight = progressBar ? progressBar.getBoundingClientRect().height : 0;
      const gap = progressBar ? BAR_TO_WIDGET_GAP : 0;
      const widgetHeight = widget.getBoundingClientRect().height;
      calendarColumn.style.setProperty('height', (barHeight + gap + widgetHeight) + 'px', 'important');
    };
    updateColumnHeight();
    new ResizeObserver(updateColumnHeight).observe(widget);
    if (progressBar) new ResizeObserver(updateColumnHeight).observe(progressBar);
  };

  /* 視覺 QA 修正 A：BTA widget 的 iframe 是用 srcdoc 掛載，跟外層頁面同源，
     contentDocument 可以直接讀取/觀察（已實機驗證）。用這個管道做兩件「只讀不改邏輯」的事：
     1. 偵測 BTA 自己彈出的 react-modal（body 出現 ReactModal__Body--open class）代表使用者
        已從「選日期」進到「確認課程細節」，用來同步我們自己疊加的進度條在哪一步。
     2. 把 BTA 介面本身固定的英文文案（按鈕、標題，不含 Booking Fields 自訂欄位——那些欄位
        本來就是後台設定的中文）逐一比對整段文字精準替換，不動任何 name/id/事件邏輯。
     BTA 若之後改版把 iframe 換成真正跨網域來源，這裡的存取會被瀏覽器拒絕，整段包在 try/catch
     裡靜默失效，不影響核心預約功能——只是進度條/中文化不會生效，需要屆時重新評估。 */
  const setupBtaContentEnhancements = (widget) => {
    const iframe = widget.querySelector('iframe');
    if (!iframe) return;

    /* srcdoc iframe 第一次被偵測到時，裡面可能還是瀏覽器自動產生的空白 document，
       真正的 srcdoc 內容還在載入中——這個空白 document 之後會被整個換掉（不是同一個
       物件），所以只在偵測到當下抓一次 contentDocument 並不可靠。用 iframe 的 load
       事件確保換成真正內容後的 document 才開始掛觀察者；同時也立刻嘗試一次，涵蓋
       load 事件在我們掛上監聽器之前就已經觸發過的情況。 */
    let attached = false;
    const tryAttach = () => {
      if (attached) return;
      const doc = iframe.contentDocument;
      if (!doc || !doc.body || !doc.body.textContent.trim()) return;
      attached = true;
      attachTranslationAndStepSync(doc);
    };
    tryAttach();
    iframe.addEventListener('load', tryAttach);
    let pollAttempts = 0;
    const attachPollId = setInterval(() => {
      pollAttempts++;
      tryAttach();
      if (attached || pollAttempts > 40) clearInterval(attachPollId);
    }, 150);
  };

  /* 視覺 QA 修正 B：BTA 的 Stage2 表單是渲染在 iframe 自己的 document 裡，有自己獨立的
     CSS cascade，外層頁面的 <style> 完全套用不到它——必須把樣式直接注入 iframe 自己的
     <head>。只調整外觀（外框、標題、欄位排版、品牌色），不動任何 name/id/class 選擇器
     以外的東西，也不碰 <select>/<input> 的 value 或送出邏輯。BTA 用 inline style 寫死了
     不少顏色/字體（來自後台 theme 設定），所以這裡的規則都要帶 !important 才蓋得過去。 */
  const injectBtaStyleSkin = (doc) => {
    let style = doc.getElementById('cbf-bta-style-skin');
    if (style) {
      /* 實測發現：styled-components 會持續動態插入新的 <style>，即使我們的規則特異度
         更高，一旦對方也用 !important 就會變成純比「誰在 <head> 裡面比較後面」，而且
         這個插入是持續發生的、不是一次性的。所以不能只在第一次掛上去，每次內容更新時
         都要把我們的 <style> 重新搬到 <head> 最後面，確保排序上永遠贏。appendChild 對
         已經存在的節點是「搬移」不是「複製」，這裡是安全的。 */
      doc.head.appendChild(style);
      return;
    }
    style = doc.createElement('style');
    style.id = 'cbf-bta-style-skin';
    style.textContent = [
      '.ReactModal__Content.ReactModal__Content { border-radius: 16px !important; }',
      '.widget-title { color: #1A2E4A !important; font-weight: 800 !important; font-size: 18px !important; text-align: left !important; margin: 0 0 4px 0 !important; padding-left: 14px !important; border-left: 4px solid #3A7AB5 !important; }',
      '.description-title { color: #5A6A78 !important; font-size: 13px !important; padding-left: 14px !important; }',
      /* Stage2 確認畫面的返回箭頭是 position:absolute 疊在標題左上角（left/top:30px），
         Stage1「Select a Date」標題原本 text-align:center 不會撞到，但只有 Stage2 這個
         modal 裡的標題有返回箭頭，所以用更高特異度的選擇器只對 Stage2 額外加 margin-left
         讓開，不影響 Stage1 標題的原本排版。 */
      '.ReactModal__Content .widget-title, .ReactModal__Content .description-title { margin-left: 40px !important; }',
      '.additional-field-label { color: #1A2E4A !important; font-weight: 700 !important; font-size: 14px !important; border-bottom: 1px solid #B8D9ED !important; padding-bottom: 8px !important; margin: 16px 0 12px 0 !important; }',
      '.control-label { color: #1A2E4A !important; font-weight: 600 !important; font-size: 13px !important; }',
      '.form-control { border: 1px solid #B8D9ED !important; border-radius: 8px !important; }',
      '.form-control:focus { border-color: #7AB3D4 !important; }',
      'button[data-type="submit"] { background-color: #1A2E4A !important; border-radius: 10px !important; font-weight: 700 !important; }',
      '.cbf-attendee-count-error { color: #C0392B !important; font-size: 12px !important; font-weight: 700 !important; margin: 6px 0 0 0 !important; display: none; }',
      'button[data-type="submit"]:disabled { opacity: 0.45 !important; cursor: not-allowed !important; }',
      '.cbf-attendee-count-button-hint { color: #C0392B !important; font-size: 12px !important; font-weight: 700 !important; margin: 0 0 8px 0 !important; text-align: center !important; display: none; }',
    ].join('\n');
    doc.head.appendChild(style);
  };

  const attachTranslationAndStepSync = (doc) => {
    try {
      const TEXT_MAP = {
        'Make a Selection': '請選擇日期',
        'Next': '下一步',
        'Book a product': '02 預訂資訊與規格確認',
        'Please confirm you would like to request the following product': '請確認您要預訂以下方案內容',
        'Additional information': '附加資訊',
        'Book Now': '確認預約',
        'Price:': '價格：',
        'Select...': '請選擇...',
      };

      const applyTranslations = () => {
        const walker = doc.createTreeWalker(doc.body, NodeFilter.SHOW_TEXT);
        let node;
        while ((node = walker.nextNode())) {
          const trimmed = node.nodeValue.trim();
          if (trimmed && Object.prototype.hasOwnProperty.call(TEXT_MAP, trimmed)) {
            node.nodeValue = node.nodeValue.replace(trimmed, TEXT_MAP[trimmed]);
          }
        }
      };

      /* 視覺 QA 修正 E-2：保險建議文案定稿。原文案被 <strong> 標籤切成好幾段文字節點
         （東京海上日動旅遊險 單獨被 <strong> 包住），逐節點比對取代不可靠，改成整段
         <p> 的 textContent 直接覆寫（會失去原本的粗體強調，換取文字逐字正確——需求
         明確要求文字要跟定稿逐字一致，優先度高於保留粗體樣式這種次要視覺細節）。用
         「東京海上日動旅遊險」這個關鍵字定位到正確的段落，換成定稿內容後就不再是
         舊文字，之後的執行不會再誤判成需要替換，天然防止重複覆寫。 */
      const FINAL_INSURANCE_TEXT = '主辦方建議於入境日本 5 天內自行投保東京海上日動旅遊險，可享中文醫療專線、免墊付醫療費、突發事故保障。';
      const applyInsuranceTextFix = () => {
        doc.querySelectorAll('.control-label p').forEach((p) => {
          if (p.textContent.indexOf('東京海上日動旅遊險') > -1 && p.textContent.replace('＊', '').trim() !== FINAL_INSURANCE_TEXT) {
            p.textContent = FINAL_INSURANCE_TEXT;
          }
        });
      };

      /* 視覺 QA 修正 E-3：必填欄位標題加註 *。實際測過 BTA 自己的送出驗證（觸發一次
         空白送出，看它自己標記哪些欄位 Required）——結果是除了「備註／其他需求」
         （唯一的 <textarea>，也是唯一 placeholder 寫著 [選填] 的欄位）以外全部必填。
         用「容器內有沒有 <textarea>」這個結構性判斷，不寫死個別欄位名稱，四個商品
         就算 Booking Fields 欄位組合不同（例如時段欄位只有半天班才有）也能通用。
         保險同意欄位比較特殊：容器裡同時有「外層長描述段落」跟「checkbox 自己的短
         標籤」兩個 .control-label，星號要加在使用者實際看到的短標籤上（呼應需求文件
         給的範例「＊我已閱讀並了解上述保險建議」），不是加在描述段落開頭。 */
      const applyRequiredAsterisks = () => {
        doc.querySelectorAll('.field-input-container').forEach((c) => {
          if (c.querySelector('textarea')) return;
          const checkboxLabel = c.querySelector('label.control-label[for]');
          const target = checkboxLabel || c.querySelector('.control-label p');
          if (target && target.textContent.trim().indexOf('＊') !== 0) {
            target.textContent = '＊' + target.textContent;
          }
        });
      };

      const syncProgressStep = () => {
        const bar = document.getElementById('bta-step-progress-bar');
        if (!bar) return;
        const step1 = bar.querySelector('[data-step="1"]');
        const step2 = bar.querySelector('[data-step="2"]');
        const isModalOpen = doc.body.classList.contains('ReactModal__Body--open');
        if (isModalOpen) {
          step1.classList.add('is-done');
          step1.classList.remove('is-active');
          step1.querySelector('.step-dot').textContent = '✓';
          step2.classList.add('is-active');
          step2.classList.remove('is-done');
        } else {
          step1.classList.add('is-active');
          step1.classList.remove('is-done');
          step1.querySelector('.step-dot').textContent = '1';
          step2.classList.remove('is-active', 'is-done');
        }
      };

      /* 實測發現：.ReactModal__Content 的 border/box-shadow 這兩個屬性，就算用注入的
         <style> 搭配 !important + 重複 class 提高特異度，還是套用不上（同一條規則裡的
         border-radius 卻套用得上，原因不明，懷疑是另一個特異度更高的規則專門重置了這
         兩個屬性）。這兩個直接改用跟 widget 定位同一招的 inline style + !important，
         那招已經證實一定贏。其餘屬性（文字顏色/欄位框線/按鈕底色等）注入的 <style> 已
         驗證有效，不需要跟著改。 */
      const applyPanelFrame = () => {
        const panel = doc.querySelector('.ReactModal__Content');
        if (!panel) return;
        panel.style.setProperty('border', '1px solid #B8D9ED', 'important');
        panel.style.setProperty('box-shadow', '0 12px 36px -4px rgba(26,46,74,0.12)', 'important');
      };

      /* 「實際參加人數」前端驗證（方案 A）：從 variant.title（例如「1 ~ 2 人」）解析出
         這個方案允許的人數範圍。BTA 官方 Add-on／Booking Field 都沒有 variant 層級限制
         選項的機制（已查證，2026-08-11），所以這裡自己算範圍再跟使用者填的「實際參加
         人數」比對，純前端疊加驗證，不動 BTA 原生任何邏輯。 */
      const parseAttendeeRange = (title) => {
        if (!title) return null;
        const match = title.match(/(\d+)\s*[~～\-]\s*(\d+)/);
        if (!match) return null;
        return { min: parseInt(match[1], 10), max: parseInt(match[2], 10) };
      };

      /* 純計算、不動 DOM：判斷目前「人數方案」（variant）跟「實際參加人數」select 的值
         是否相符。即時 disabled 連動（validateAttendeeCount）跟送出攔截（click capture）
         共用同一套判斷邏輯跟訊息文字，避免兩處各自維護，以後改文案只需要改一個地方。 */
      const checkAttendeeCount = (select) => {
        const range = parseAttendeeRange(window.__cbfSelectedVariantTitle);
        if (!range) return { valid: true, range: null };
        const count = parseInt(select.value, 10);
        const valid = !!count && count >= range.min && count <= range.max;
        return {
          valid,
          range,
          message: '您選擇的方案為 ' + range.min + '-' + range.max + ' 人，請填寫對應的實際參加人數',
        };
      };

      /* 錯誤提示可見性優化（2026-08-12）：比照 Stage3 checkbox 已驗證過的「即時反應」模式，
         不再只在送出時才攔截。「實際參加人數」select 的 change、Stage1「人數方案」variant
         切換（cbf:variantChanged 自訂事件，見檔案最上方早期 <script>）任一觸發，都重新
         執行這個函式，同步更新三件事：
         1) 送出按鈕 disabled 狀態——送出按鈕會被 BTA React 重繪成新節點，所以這裡也跟著
            runUpdates() 的其他函式一樣每次重繪後都要重新套用，不能只設一次就放著
         2) 按鈕正上方新增的提示文字，讓使用者捲到按鈕位置時不用往回捲就能看到原因
         3) 欄位旁原有的錯誤提示，沿用既有邏輯不變，跟按鈕旁提示同時存在、文字一致
         只清除「我們自己」造成的 disabled（用 data-cbf-attendee-invalid 標記），避免蓋掉
         BTA 自己因其他必填欄位缺漏而設的 disabled 狀態（兩者互不干擾）。 */
      const validateAttendeeCount = () => {
        const select = doc.querySelector('select[name="實際參加人數"]');

        /* 實測發現：Stage1 的日曆畫面（含它自己的 button[data-type="submit"]「下一頁」）
           在切到 Stage2 確認畫面後依然留在 DOM 裡（Stage2 是疊加的 ReactModal，不是取代
           Stage1），所以整份 doc 裡同時存在兩個 button[data-type="submit"]。如果直接用
           doc.querySelector 抓「第一個」會抓到 Stage1 的「下一頁」而不是 Stage2 真正的
           「立即預訂」。改成優先在「實際參加人數」select 所在的 .ReactModal__Content 範圍
           內找，範圍找不到才退回全域第一個（沒有這個欄位的畫面本來就會提早 return）。 */
        const scope = (select && (select.closest('.ReactModal__Content') || select.closest('form'))) || doc;
        const btn = scope.querySelector('button[data-type="submit"]') || doc.querySelector('button[data-type="submit"]');
        if (!btn) return;

        let errorEl = doc.getElementById('cbf-attendee-count-error');
        let hintEl = doc.getElementById('cbf-attendee-count-button-hint');

        if (!select) {
          // 這個畫面沒有這個欄位（例如選日期那一步），清掉可能殘留的狀態，正常放行
          if (errorEl) errorEl.style.display = 'none';
          if (hintEl) hintEl.style.display = 'none';
          if (btn.dataset.cbfAttendeeInvalid) {
            btn.disabled = false;
            delete btn.dataset.cbfAttendeeInvalid;
          }
          return;
        }

        const container = select.closest('.field-input-container') || select.parentElement;
        if (!errorEl) {
          errorEl = doc.createElement('p');
          errorEl.id = 'cbf-attendee-count-error';
          errorEl.className = 'cbf-attendee-count-error';
          container.appendChild(errorEl);
        }
        if (!hintEl) {
          hintEl = doc.createElement('p');
          hintEl.id = 'cbf-attendee-count-button-hint';
          hintEl.className = 'cbf-attendee-count-button-hint';
        }
        // 按鈕本身每次重繪都是新節點，這裡確保提示文字永遠緊貼在「目前這顆」按鈕正上方
        if (btn.parentNode && hintEl.nextSibling !== btn) {
          btn.parentNode.insertBefore(hintEl, btn);
        }

        const result = checkAttendeeCount(select);
        if (!result.range) {
          /* 邊界情況：抓不到目前選擇的方案（variantChanged 沒有如預期觸發，或文字格式
             跟預期不同）。這層驗證是加分防呆，不應該變成擋住正常流程的新故障點，記錄
             警告方便日後排查，然後正常放行。 */
          console.warn('[實際參加人數驗證] 無法判斷目前選擇的方案人數範圍（variant title: ' + window.__cbfSelectedVariantTitle + '），略過這層驗證，正常放行送出。');
          errorEl.style.display = 'none';
          hintEl.style.display = 'none';
          if (btn.dataset.cbfAttendeeInvalid) {
            btn.disabled = false;
            delete btn.dataset.cbfAttendeeInvalid;
          }
          return;
        }

        if (!result.valid) {
          errorEl.textContent = result.message;
          errorEl.style.display = 'block';
          hintEl.textContent = result.message;
          hintEl.style.display = 'block';
          btn.disabled = true;
          btn.dataset.cbfAttendeeInvalid = '1';
        } else {
          errorEl.style.display = 'none';
          hintEl.style.display = 'none';
          if (btn.dataset.cbfAttendeeInvalid) {
            btn.disabled = false;
            delete btn.dataset.cbfAttendeeInvalid;
          }
        }
      };

      /* 用 capture phase 監聽掛在 doc 最外層（不是掛在按鈕/select 本身——兩者都會被 React
         每次重新渲染成新節點，直接掛監聽器會變成死監聽器，跟這個檔案其他地方「監聽穩定
         容器、不監聽會被取代的節點」是同一個教訓）。這些監聽器只需要掛一次，掛在 doc 上
         不會因為 BTA 重繪內容而失效。 */
      const setupAttendeeCountValidation = () => {
        /* 送出時的最後一道防呆（雙重防呆，比照 Stage3 checkbox 模式）：即使 disabled
           理論上點不到，capture phase 攔截仍保留，避免 disabled 屬性被其他腳本／瀏覽器
           擴充功能意外移除而繞過檢查。capture phase 保證比 BTA 自己 React 事件系統的
           監聽時機更早攔截到，驗證不通過就 stopPropagation/stopImmediatePropagation，
           讓事件根本不會傳到 BTA 自己的 handler。 */
        doc.addEventListener('click', (event) => {
          const btn = event.target.closest && event.target.closest('button[data-type="submit"]');
          if (!btn) return;
          const select = doc.querySelector('select[name="實際參加人數"]');
          if (!select) return;
          const result = checkAttendeeCount(select);
          if (result.range && !result.valid) {
            event.preventDefault();
            event.stopPropagation();
            event.stopImmediatePropagation();
          }
        }, true);

        // 「實際參加人數」select 變動：即時重新驗證，不用等送出才知道
        doc.addEventListener('change', (event) => {
          const select = event.target.closest && event.target.closest('select[name="實際參加人數"]');
          if (!select) return;
          validateAttendeeCount();
        }, true);

        // 「人數方案」（Stage1 variant）切換：橋接自訂事件掛在頂層 document 上（見檔案
        // 最上方早期 <script>，跟這裡不共用作用域，用自訂事件通知）。
        document.addEventListener('cbf:variantChanged', validateAttendeeCount);

        /* 保底輪詢：跟這個檔案別處「MutationObserver 可能因為 BTA 特殊的 DOM 操作方式而
           沒被觸發」是同一個既有教訓（見 checkAndReveal 旁的 pollId 保底輪詢）。實測發現
           Stage2 確認 Modal 剛開啟、使用者還沒手動變動任何欄位的那個當下，偶爾會遇到
           MutationObserver 沒有如預期觸發 runUpdates() 的情況，導致「預設值不合理時按鈕
           應立即 disabled」這條驗收標準在部分情況下摸不到——用低頻率輪詢當保底，跟
           MutationObserver 雙重覆蓋，函式本身很輕量（純 querySelector 比對），indefinite
           輪詢的成本可以忽略。 */
        setInterval(validateAttendeeCount, 700);
      };

      let pending = false;
      const runUpdates = () => {
        injectBtaStyleSkin(doc);
        applyPanelFrame();
        applyTranslations();
        applyInsuranceTextFix();
        applyRequiredAsterisks();
        syncProgressStep();
        validateAttendeeCount();
      };
      const contentObserver = new MutationObserver(() => {
        if (pending) return;
        pending = true;
        requestAnimationFrame(() => {
          pending = false;
          runUpdates();
        });
      });
      contentObserver.observe(doc.body, {
        childList: true, subtree: true, characterData: true,
        attributes: true, attributeFilter: ['class'],
      });
      setupAttendeeCountValidation();
      runUpdates();
    } catch (e) {
      /* 存取被拒或結構不符預期，靜默略過，不拋錯打斷其他既有功能 */
    }
  };

  const checkAndReveal = () => {
    const widget = document.getElementById('bta-product-widget');
    if (widget && widget.querySelector('iframe')) {
      revealStepUI();
      positionWidgetOverlay();
      setupBtaContentEnhancements(widget);
      return true;
    }
    return false;
  };
  if (!checkAndReveal()) {
    const observer = new MutationObserver((mutations, obs) => {
      if (checkAndReveal()) {
        obs.disconnect();
        clearInterval(pollId);
      }
    });
    observer.observe(watchContainer, { childList: true, subtree: true });
    observer.observe(document.body, { childList: true, subtree: true });

    /* 保底輪詢：MutationObserver 可能因為 BTA 特殊的 DOM 操作方式而沒被觸發，
       用輪詢確保無論如何都能在 iframe 出現後盡快抓到，15 秒後放棄避免無限跑。 */
    let pollAttempts = 0;
    const pollId = setInterval(() => {
      pollAttempts++;
      if (checkAndReveal() || pollAttempts > 100) {
        clearInterval(pollId);
        observer.disconnect();
      }
    }, 150);
  }
})();
</script>

