    <!-- 3. 右欄：純粹交易漏斗工具卡片 (佔 35% 寬度 + Sticky 捲動固定) -->
    <div class="course-sticky-right-card" style="position: sticky; top: 120px;">
      <div class="course-booking-card-body">
        <div id="bta-booking-form-{{ product.id }}" data-product-id="{{ product.id }}">
          <!-- BTA「Snow class booking」Inline widget 真正偵測的錨點 id（從 bta-widgets-bootstrap.min.js 原始碼確認）。
               原本的 Stage1/2/3 精靈（人數下拉選單、假日曆容器、下一步按鈕、Stage2 雪板類型/場地/聯絡方式等自訂欄位、Stage3 裝備租借）
               已整組移除：BTA widget 自己的流程已原生涵蓋日期/人數/雪板類型/場地/聯絡方式/兒童同行，裝備加購改在購物車頁由
               assets/course-stage2-module.js 處理，不需要在商品頁重複刻一套。 -->
          <div id="booking-current-date-picker">
            <div id="bta-step-progress-bar" class="bta-step-progress-bar">
              <div class="booking-progress-stepper">
                <div class="step-item is-active" data-step="1"><span class="step-dot">1</span><span>日期</span></div>
                <div class="step-line">➔</div>
                <div class="step-item" data-step="2"><span class="step-dot">2</span><span>資訊</span></div>
                <div class="step-line">➔</div>
                <div class="step-item" data-step="3"><span class="step-dot">3</span><span>加購</span></div>
              </div>
            </div>
            <div id="bta-product-widget" class="bta-calendar-picker-canvas"></div>
          </div>
        </div>
