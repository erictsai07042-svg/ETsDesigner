{% comment %}
  【來趣滑雪】2026-07-28 UX 重構完全體 - 去重複、進度條、品牌字級修正
  snippets/course-booking-form.liquid
{% endcomment %}

<style>

/* ==========================================================================
   🎨 【來趣滑雪】2026-07-28 終極美學大改組：4:6 黃金非對稱網格控制系統
   ========================================================================== */
:root {
  --color-primary-navy: #1A2E4A;
  --color-secondary-blue: #2D5F8A;
  --color-frost: #B8D9ED;
  --color-snow-white: #E8F4FA;
  --color-slope-black: #111111;
  --color-stone-gray: #5A6A78;
  --premium-card-shadow: 0 10px 30px -5px rgba(26, 46, 74, 0.05);

  /* Fallbacks for preserved CSS */
  --cbf-navy: #1A2E4A;
  --cbf-mountain: #2D5F8A;
  --cbf-sky: #3A7AB5;
  --cbf-ice: #7AB3D4;
  --cbf-frost: #B8D9ED;
  --cbf-snow: #E8F4FA;
  --cbf-stone: #5A6A78;
  --cbf-black: #111111;
  --cbf-white: #ffffff;
}

/* 🚫 全域排他網盾：強制摧毀原廠下滑全域懸浮條與 You may also like 推薦商品區塊 */
.product-recommendations, #shopify-section-product-recommendations, 
sticky-add-to-cart, .product-sticky-bar, .shopify-section--sticky-add-to-cart {
  display: none !important; opacity: 0 !important; visibility: hidden !important;
}

/* 🚫 物理隱藏原廠的相關殘餘干擾元素，確保本旗艦容器擁有純淨無瑕的舞台 */
.product-information__media,
.product-single__media-group,
.product__media-wrapper,
[data-testid="product-information-media"] {
  display: none !important;
}

/* 原生兩欄版位收合成單欄：媒體圖庫已隱藏，讓 product-details（含 form／variant-picker／buy-buttons）佔滿寬度。
   保留 DOM 結構不變（不用 JS 搬移），純視覺調整，確保 BTA 錨點與表單巢狀關係不受影響。 */
.product-information__grid {
  grid-template-columns: 1fr !important;
}
.product-information__grid .product-details {
  grid-column: 1 / -1 !important;
}

/* 隱藏原生標題／價格區塊（與 STEP UI 自己的 hero banner 重複），保留 form、variant-picker、buy-buttons 不動 */
.product-details [data-block-id$="__group_icgrde"] {
  display: none !important;
}
.product-details [class*="__divider_VJhene"] {
  display: none !important;
}

/* 一切回歸中道：預訂漏斗外殼完全依照品牌規範齊寬對齊 (不使用滿版) */
.ski-booking-funnel-wrapper {
  font-family: var(--brand-font-family, 'PingFang TC', 'Microsoft JhengHei', sans-serif) !important;
  max-width: 1200px;
  width: 100%;
  margin: 0 auto 60px auto;
  padding: 0 24px;
  box-sizing: border-box;
  color: var(--color-slope-black, #111111);
}

/* ==========================================================================
   🌟 1. 頂部滑雪情境橫幅 Banner (容器寬度 + 圓角 + 漸變遮罩 + 白色字)
   ========================================================================== */
.course-hero-banner {
  position: relative;
  width: 100%;
  min-height: 260px;
  max-height: 320px;
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  align-items: center;
  background-color: var(--brand-deep-navy, #1A2E4A);
  margin-bottom: 32px;
  box-shadow: 0 14px 36px rgba(26, 46, 74, 0.15);
}

.course-hero-banner__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
  z-index: 1;
  transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}
.course-hero-banner:hover .course-hero-banner__img {
  transform: scale(1.02);
}

.course-hero-banner__fallback-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #1A2E4A 0%, #2D5F8A 50%, #7AB3D4 100%);
  z-index: 1;
}

/* 左側半透明深色遮罩：優雅漸變襯托白字，確保閱讀辨識度百分之百 */
.course-hero-banner__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(26, 46, 74, 0.94) 0%, rgba(26, 46, 74, 0.78) 50%, rgba(26, 46, 74, 0.15) 100%);
  z-index: 2;
}

.course-hero-banner__content {
  position: relative;
  z-index: 3;
  padding: 44px 52px;
  max-width: 680px;
  color: #ffffff !important;
}

.course-hero-badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.25);
  padding: 5px 14px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.05em;
  margin-bottom: 12px;
}

.course-hero-title {
  font-family: var(--brand-font-family) !important;
  font-size: clamp(24px, 4vw, 36px) !important;
  font-weight: 800 !important;
  line-height: 1.25 !important;
  color: #ffffff !important;
  margin: 0 0 16px 0 !important;
  letter-spacing: 0.02em;
}

.course-hero-price {
  display: flex;
  align-items: baseline;
  gap: 12px;
  background: rgba(0, 0, 0, 0.22);
  padding: 8px 18px;
  border-radius: 8px;
  border-left: 4px solid var(--brand-ice-blue, #7AB3D4);
  width: fit-content;
}

.course-hero-price .price-label {
  font-size: 14px;
  font-weight: 600;
  color: #B8D9ED;
  letter-spacing: 0.04em;
}

.course-hero-price .price-value,
.course-hero-price .price-value * {
  font-size: 24px !important;
  font-weight: 800 !important;
  color: #ffffff !important;
  margin: 0 !important;
  line-height: 1 !important;
}

/* ==========================================================================
   🌟 2. 主內容兩欄網格：左側 65% (資訊說明) + 右側 35% (預訂卡片)
   ========================================================================== */
.course-main-layout-grid {
  display: grid;
  grid-template-columns: minmax(0, 65fr) minmax(0, 35fr);
  gap: 36px;
  align-items: start;
}
@media (max-width: 991px) {
  .course-main-layout-grid {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
}

/* ==========================================================================
   📜 3. 左側文字資訊區塊 (65% 欄位) 樣式
   ========================================================================== */
.course-info-left-column {
  display: flex;
  flex-direction: column;
  gap: 36px;
  min-width: 0;
}

.info-block-card {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  padding: 32px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
}

/* 依照表單與品牌規範：標題加上 Sky Blue 左邊線與 0.04em 字距 */
.info-block-title {
  color: var(--brand-deep-navy, #1A2E4A) !important;
  font-size: 22px !important;
  font-weight: 800 !important;
  letter-spacing: 0.04em !important;
  padding-left: 14px !important;
  border-left: 4px solid var(--brand-sky-blue, #3A7AB5) !important;
  margin: 0 0 24px 0 !important;
  line-height: 1.3 !important;
}

.info-highlight-box {
  background: var(--brand-snow, #E8F4FA);
  border: 1px solid var(--brand-frost, #B8D9ED);
  border-radius: 12px;
  padding: 20px 24px;
  margin-bottom: 20px;
}
.info-highlight-box .box-tag {
  display: inline-block;
  background: var(--brand-deep-navy, #1A2E4A);
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  padding: 2px 10px;
  border-radius: 4px;
  margin-bottom: 8px;
}
.info-highlight-box .box-main {
  font-size: 18px;
  font-weight: 700;
  color: var(--brand-deep-navy, #1A2E4A);
  margin: 0 0 6px 0;
}
.info-highlight-box .box-sub {
  font-size: 15px;
  color: var(--brand-stone-gray, #5A6A78);
  margin: 0;
}

.info-list-group {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.info-row-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 14px 18px;
  background: #f8fafc;
  border-radius: 8px;
  border-left: 3px solid #cbd5e1;
}
.info-row-item .row-label {
  font-size: 14px;
  font-weight: 700;
  color: var(--brand-deep-navy, #1A2E4A);
}
.info-row-item .row-val {
  font-size: 15px;
  color: #334155;
  line-height: 1.6;
}

.styled-feature-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.styled-feature-list li {
  position: relative;
  padding-left: 24px;
  font-size: 15px;
  line-height: 1.7;
  color: #334155;
}
.styled-feature-list li::before {
  content: "■";
  position: absolute;
  left: 2px;
  top: -1px;
  font-size: 10px;
  color: var(--brand-sky-blue, #3A7AB5);
}
.styled-feature-list li strong {
  color: var(--brand-deep-navy, #1A2E4A);
}

.policy-table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 20px;
  font-size: 14px;
}
.policy-table th {
  background: var(--brand-deep-navy, #1A2E4A);
  color: #ffffff;
  padding: 12px 16px;
  text-align: left;
  font-weight: 700;
}
.policy-table td {
  padding: 12px 16px;
  border-bottom: 1px solid #e2e8f0;
  color: #334155;
}
.policy-table tr:nth-child(even) {
  background-color: #f8fafc;
}
.hl-green { color: #059669; font-weight: 800; }
.hl-amber { color: #d97706; font-weight: 800; }
.hl-orange { color: #ea580c; font-weight: 800; }
.hl-red { color: #dc2626; font-weight: 800; }

.policy-note {
  font-size: 13px;
  color: var(--brand-stone-gray, #5A6A78);
  line-height: 1.7;
  background: #f1f5f9;
  padding: 14px 18px;
  border-radius: 8px;
  margin: 0;
}

/* ==========================================================================
   🔒 4. 右側固定預訂卡片 (35% 欄位 + Sticky)
   ========================================================================== */
.course-sticky-right-card {
  position: sticky !important;
  top: 120px !important;
  align-self: start !important;
  z-index: 10;
  width: 100%;
}

@media (max-width: 991px) {
  .course-sticky-right-card {
    position: static !important;
  }
}

.course-booking-card-body {
  background: #ffffff;
  border: 1px solid var(--brand-frost, #B8D9ED);
  border-radius: 20px;
  padding: 28px 24px;
  box-shadow: 0 12px 36px -4px rgba(26, 46, 74, 0.12);
  position: relative;
  overflow: hidden;
}

.course-booking-card-body::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 5px;
  background: linear-gradient(90deg, #1A2E4A 0%, #2D5F8A 50%, #7AB3D4 100%);
}

.card-consent-section {
  margin-top: 24px;
  border-top: 1px dashed #e2e8f0;
  padding-top: 18px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.compact-cb-row {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 10px 12px;
  transition: all 0.2s ease;
}
.compact-cb-row:hover {
  border-color: var(--brand-ice-blue, #7AB3D4);
  background: var(--brand-snow, #E8F4FA);
}
.compact-cb-row.is-agreed {
  background: #ecfdf5;
  border-color: #6ee7b7;
}

.compact-cb-row .consent-checkbox-row {
  display: flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
  margin: 0;
}
.compact-cb-row .required-consent-cb {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  accent-color: var(--brand-deep-navy, #1A2E4A);
  cursor: pointer;
}
.compact-cb-row .consent-checkbox-label {
  font-size: 13px;
  font-weight: 600;
  color: var(--brand-deep-navy, #1A2E4A);
  line-height: 1.4;
}
.compact-cb-row .consent-checkbox-label a {
  color: var(--brand-sky-blue, #3A7AB5);
  text-decoration: underline;
  margin-left: 4px;
}

.consent-unlock-hint {
  font-size: 13px;
  color: #dc2626;
  background: #fef2f2;
  border: 1px solid #fecaca;
  padding: 10px 14px;
  border-radius: 8px;
  font-weight: 600;
  line-height: 1.5;
  display: none;
}
.consent-unlock-hint.is-visible {
  display: block;
}

/* ==========================================================================
    【來趣滑雪】終極除錯：強制物理隱藏原廠商品描述，消滅資訊重複
   ========================================================================== */
{% if product.type == 'Course' or product.handle contains 'course' %}
  .product__description,
  .product-single__description,
  .product-description,
  .rt,
  .rte {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    height: 0 !important;
    overflow: hidden !important;
    margin: 0 !important;
    padding: 0 !important;
  }
{% endif %}

.consent-checkbox-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  background: var(--cbf-snow);
  border-top: 1px solid var(--cbf-frost);
  cursor: pointer;
}
.consent-checkbox-row input[type="checkbox"] {
  appearance: none; -webkit-appearance: none;
  width: 18px; height: 18px; flex-shrink: 0;
  border: 2px solid var(--cbf-frost); border-radius: 4px;
  background: #fff; cursor: pointer;
  transition: all 0.15s ease; position: relative;
}
.consent-checkbox-row input[type="checkbox"]:checked {
  background-color: #16a34a; border-color: #16a34a;
}
.consent-checkbox-row input[type="checkbox"]:checked::after {
  content: '✓'; position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%); color: #fff;
  font-size: 11px; font-weight: 700;
}
.consent-checkbox-label {
  font-size: 13px;
  font-weight: 600;
  color: var(--cbf-navy);
  line-height: 1.4;
  cursor: pointer;
}

/* 解鎖提示區（未完成勾選時顯示） */
.consent-unlock-hint {
  font-size: 12px;
  color: #dc2626;
  text-align: center;
  padding: 8px 12px;
  background: #fef2f2;
  border: 1px solid #fecaca;
  border-radius: 8px;
  margin-bottom: 10px;
  display: none;
}
.consent-unlock-hint.is-visible { display: block; }

</style>


<!-- ==========================================================================
   【來趣滑雪】2026-07-28 UX 重構完全體 - 齊寬修正與去 Emoji 純文字版
   ========================================================================== -->

<div class="ski-booking-funnel-wrapper" style="max-width: 1200px; margin: 0 auto 100px auto; padding: 0;">

  <!-- 1. 頂部滑雪情境橫幅 Banner (移除內建 padding，確保與下方 100% 齊寬) -->
  <div class="course-hero-banner rounded-2xl" style="margin-left: -32px; margin-right: -24px; width: calc(100% + 56px); box-sizing: border-box;">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | img_url: '1200x' }}" class="course-hero-banner__img" alt="{{ product.title | escape }}">
    {% else %}
      <div class="course-hero-banner__fallback-img"></div>
    {% endif %}
    <div class="course-hero-banner__overlay"></div>
    <div class="course-hero-banner__content">
      <span class="course-hero-badge">Life Chill Snow 專業滑雪課程</span>
      <h1 class="course-hero-title">{{ product.title }}</h1>
      <div class="course-hero-price">
        <span class="price-label">極致優惠價</span>
        <span class="price-value" id="BannerTotalPrice">{{ product.price | money }}</span>
      </div>
    </div>
  </div>

  <!-- 兩欄主結構容器 (與上方 Banner 同步外推與寬度，確保 100% 垂直齊平) -->
  <div class="course-main-layout-grid" style="margin-left: -32px; margin-right: -24px; width: calc(100% + 56px); box-sizing: border-box;">
    
    <!-- 2. 左欄：主內容與條款確認區 (佔 65% 寬度) -->
    <div class="course-info-left-column">
      
      <!-- 區塊 A：您選擇的方案與基本確認 -->
      <div class="info-block-card">
        <h3 class="info-block-title">您選擇的方案資訊</h3>
        <div class="info-highlight-box">
          <span class="box-tag">時段與集合地點</span>
          <p class="box-main" id="DynamicCourseTimeText">
            {% if product.tags contains '全天班' %}
              全天班（6小時，含1小時午休）｜ 課程時間：09:00～15:00
            {% else %}
              半天班（3小時）｜ 上午：09:00～12:00 ／ 下午：13:00～16:00
            {% endif %}
          </p>
          <p class="box-sub">集合地點：訂單完成後與教練確認</p>
        </div>

        <div class="info-row-item" style="border-left-color: var(--brand-ice-blue); margin-bottom: 20px;">
          <span class="row-label">兒童教學政策</span>
          <span class="row-val">親子班兒童最低年齡為 6 歲，需有至少 1 位成人陪同，每組最多接受 1 位兒童同行。</span>
        </div>

        <h3 class="info-block-title" style="margin-top: 32px;">費用資訊</h3>
        <div class="info-list-group">
          <div class="info-row-item">
            <span class="row-label">費用包含/不含項目</span>
            <span class="row-val">費用僅含教學服務，不含裝備租借、纜車票及餐費。如需教練協助裝備租借，時間計入課程時數內。</span>
          </div>
          <div class="info-row-item">
            <span class="row-label">延長課程費用</span>
            <span class="row-val">NT$3,000／USD$100／JPY¥15,000／小時（3～4人方案：NT$3,600／小時）。</span>
          </div>
          <div class="info-row-item" style="background-color: #fffbeb; border-left-color: #f59e0b;">
            <span class="row-label" style="color: #b45309;">旺季期間提示</span>
            <span class="row-val" style="color: #78350f;">2026年12月16日～2027年2月28日（此期間報價將依旺季費率計算）。</span>
          </div>
        </div>
      </div>

      <!-- 區塊 B：法律免責與下單硬性條件 -->
      <div class="info-block-card">
        <h3 class="info-block-title">安全規範、資格確認與退款政策</h3>
        <div class="card-consent-section" style="margin-top: 0; padding-top: 0; border: none;">
          <div class="compact-cb-row" id="ConsentCard1" style="margin-bottom: 12px;">
            <label class="consent-checkbox-row">
              <input type="checkbox" class="required-consent-cb" id="CheckBoxConsent1">
              <span class="consent-checkbox-label">
                <strong>我已確認符合參加資格</strong>：已評估自身健康狀況（無懷孕、心臟病、高血壓、癲癇等不適宜滑雪之疾病）。未成年（18歲以下）已獲得監護人陪同同意。
              </span>
            </label>
          </div>
          <div class="compact-cb-row" id="ConsentCard2" style="margin-bottom: 12px;">
            <label class="consent-checkbox-row">
              <input type="checkbox" class="required-consent-cb" id="CheckBoxConsent2">
              <span class="consent-checkbox-label">
                <strong>我已詳閱並同意退款政策</strong>：活動前14天取消退100%；7-13天退70%；1-6天退50%；當天取消恕不退款。天候不佳或纜車停駛可全額退款或免費改期。所有退款扣5%手續費。
              </span>
            </label>
          </div>
          <div class="compact-cb-row" id="ConsentCard3">
            <label class="consent-checkbox-row">
              <input type="checkbox" class="required-consent-cb" id="CheckBoxConsent3">
              <span class="consent-checkbox-label">
                <strong>我已同意安全規範與風險聲明</strong>：聽從教練指示，不擅自離開教學區。本課程不含保險，我已知悉並承諾於活動前自行投保（建議東京海上日動旅遊險）。
              </span>
            </label>
          </div>
        </div>
        <div class="consent-unlock-hint" id="ConsentUnlockHint" style="margin-top: 16px;">
          請勾選上方三項安全聲明與政策同意書，以解鎖右側預訂結帳按鈕。
        </div>
      </div>

      <!-- 區塊 C：售後服務與次要資訊 -->
      <div class="info-block-card">
