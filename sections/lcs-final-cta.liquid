{%- liquid
  assign has_image = false
  if section.settings.image != blank or section.settings.image_asset != blank
    assign has_image = true
  endif
-%}
<div class="lcs-band lcs-band--dark lcs-cta{% if has_image %} lcs-cta--has-image{% endif %}" {{ section.shopify_attributes }}>
  {%- if has_image -%}
    <div class="lcs-bg" style="--lcs-bg-overlay: 0.7;" aria-hidden="true">
      {% render 'lcs-image', image: section.settings.image, asset: section.settings.image_asset, alt: '', sizes: '100vw', width: 2400 %}
    </div>
  {%- endif -%}
  <div class="lcs-inner lcs-cta__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="lcs-eyebrow" data-lcs-reveal>{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="lcs-home-title" data-lcs-reveal>{% render 'lcs-clauses', text: section.settings.heading, sep: '，' %}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="lcs-cta__text" data-lcs-reveal data-lcs-reveal-delay="90">{% render 'lcs-clauses', text: section.settings.text, sep: '，' %}</p>
    {%- endif -%}

    <div class="lcs-cta__actions" data-lcs-reveal data-lcs-reveal-delay="180">
      {%- if section.settings.primary_label != blank and section.settings.primary_link != blank -%}
        <a class="lcs-home-btn" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }}</a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
        <a
          class="lcs-home-btn lcs-home-btn--outline"
          href="{{ section.settings.secondary_link }}"
          {% if section.settings.secondary_link contains 'line.me' %}target="_blank" rel="noopener noreferrer"{% endif %}
        >{{ section.settings.secondary_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .lcs-cta {
    overflow: hidden;
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .lcs-cta__inner {
    max-width: 48rem;
    text-align: center;
  }

  .lcs-cta__text {
    margin: 1.25rem auto 0;
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    line-height: 1.8;
    color: var(--lcs-frost);
    text-wrap: balance;
  }

  .lcs-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .lcs-band--dark .lcs-home-btn.lcs-home-btn--outline {
    color: var(--lcs-white);
    background-color: transparent;
    border-color: var(--lcs-ice);
  }

  .lcs-band--dark .lcs-home-btn.lcs-home-btn--outline:hover {
    color: var(--lcs-navy);
    background-color: var(--lcs-ice);
    border-color: var(--lcs-ice);
  }

  @media screen and (max-width: 749px) {
    .lcs-cta__actions .lcs-home-btn {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.lcs_final_cta",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.lcs_eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.lcs_heading",
      "default": "要訂課，或先問問題。"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:settings.lcs_subheading"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:settings.lcs_primary_label"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "t:settings.lcs_primary_link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:settings.lcs_secondary_label"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:settings.lcs_secondary_link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.lcs_image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "t:settings.lcs_image_asset"
    }
  ],
  "presets": [
    {
      "name": "t:names.lcs_final_cta"
    }
  ]
}
{% endschema %}
