<div class="lcs-band lcs-band--dark lcs-value" {{ section.shopify_attributes }}>
  <div class="lcs-inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="lcs-eyebrow" data-lcs-reveal>{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="lcs-home-title" data-lcs-reveal>{% render 'lcs-clauses', text: section.settings.heading, sep: '，' %}</h2>
    {%- endif -%}

    <ul class="lcs-value__stats" role="list">
      {%- for block in section.blocks -%}
        <li class="lcs-value__stat" data-lcs-reveal data-lcs-reveal-delay="{{ forloop.index0 | times: 90 }}" {{ block.shopify_attributes }}>
          <p class="lcs-value__number">
            <span
              class="lcs-display"
              {%- if block.settings.count_up %}
                data-lcs-count="{{ block.settings.value | escape }}"
                data-lcs-decimals="{{ block.settings.decimals }}"
              {%- endif -%}
            >{{ block.settings.value | escape }}</span>
            {%- if block.settings.unit != blank -%}
              <span class="lcs-value__unit">{{ block.settings.unit | escape }}</span>
            {%- endif -%}
          </p>
          {%- if block.settings.caption != blank -%}
            {%- liquid
              assign caption_sep = '，'
              if block.settings.caption contains '・'
                assign caption_sep = '・'
              endif
            -%}
            <p class="lcs-value__caption">{% render 'lcs-clauses', text: block.settings.caption, sep: caption_sep %}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .lcs-value__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.25rem;
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .lcs-value__stat {
    padding-top: 1.25rem;
    border-top: 1px solid var(--lcs-mountain);
  }

  .lcs-value__number {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    margin: 0;
  }

  .lcs-value .lcs-display {
    font-size: clamp(2.25rem, 6vw, 4.25rem);
  }

  .lcs-value__unit {
    font-size: clamp(1rem, 2vw, 1.5rem);
    font-weight: 600;
    color: var(--lcs-ice);
  }

  .lcs-value__caption {
    margin: 0.625rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--lcs-frost);
    text-wrap: balance;
  }

  @media screen and (min-width: 1000px) {
    .lcs-value__stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.lcs_value_band",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.lcs_eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.lcs_heading",
      "default": "教練講中文，一組最多四個人。"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "t:names.lcs_stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "t:settings.lcs_value",
          "default": "4"
        },
        {
          "type": "checkbox",
          "id": "count_up",
          "label": "t:settings.lcs_count_up",
          "default": false
        },
        {
          "type": "range",
          "id": "decimals",
          "label": "t:settings.lcs_decimals",
          "min": 0,
          "max": 2,
          "step": 1,
          "default": 0
        },
        {
          "type": "text",
          "id": "unit",
          "label": "t:settings.lcs_unit"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:settings.lcs_caption"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:names.lcs_value_band",
      "blocks": [
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}
