<div class="lcs-band lcs-band--ice lcs-resort" {{ section.shopify_attributes }}>
  <div class="lcs-inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="lcs-eyebrow" data-lcs-reveal>{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="lcs-home-title" data-lcs-reveal>{% render 'lcs-clauses', text: section.settings.heading, sep: '，' %}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="lcs-resort__lead" data-lcs-reveal data-lcs-reveal-delay="90">{% render 'lcs-clauses', text: section.settings.text, sep: '，' %}</p>
    {%- endif -%}

    <ul class="lcs-resort__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tag = 'div'
          if block.settings.link != blank
            assign tag = 'a'
          endif
        -%}
        <li class="lcs-resort__item" data-lcs-reveal data-lcs-reveal-delay="{{ forloop.index0 | times: 90 }}" {{ block.shopify_attributes }}>
          <{{ tag }} class="lcs-resort__card"{% if tag == 'a' %} href="{{ block.settings.link }}"{% endif %}>
            <span class="lcs-resort__media{% if block.settings.image == blank %} lcs-resort__media--empty{% endif %}">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 22vw, (min-width: 560px) 45vw, 90vw', alt: block.settings.name }}
              {%- endif -%}
              {%- if block.settings.tag != blank -%}
                <span class="lcs-resort__tag">{{ block.settings.tag | escape }}</span>
              {%- endif -%}
            </span>
            <span class="lcs-resort__body">
              <h3 class="lcs-resort__name">{{ block.settings.name | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <span class="lcs-resort__text">{% render 'lcs-clauses', text: block.settings.text, sep: '，' %}</span>
              {%- endif -%}
            </span>
          </{{ tag }}>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .lcs-resort__lead {
    margin: 1rem 0 0;
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    line-height: 1.7;
    color: var(--lcs-stone);
    text-wrap: balance;
  }

  .lcs-resort__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .lcs-resort__item {
    display: flex;
  }

  .lcs-resort__card {
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow: hidden;
    color: var(--lcs-navy);
    text-decoration: none;
    background-color: var(--lcs-white);
    border: 1px solid var(--lcs-frost);
    border-radius: 16px;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  a.lcs-resort__card:hover {
    border-color: var(--lcs-ice);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(26, 46, 74, 0.12);
  }

  a.lcs-resort__card:focus-visible {
    outline: 2px solid var(--lcs-sky);
    outline-offset: 3px;
  }

  .lcs-resort__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--lcs-navy);
  }

  .lcs-resort__media--empty {
    background-image: linear-gradient(160deg, var(--lcs-mountain) 0%, var(--lcs-navy) 100%);
  }

  .lcs-resort__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lcs-resort__tag {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--lcs-navy);
    background-color: var(--lcs-snow);
    border-radius: 999px;
  }

  .lcs-resort__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.125rem 1.25rem 1.375rem;
  }

  .lcs-resort__card .lcs-resort__name {
    margin: 0;
    font-size: 1.25rem !important;
    font-weight: 700 !important;
    line-height: 1.35 !important;
    color: var(--lcs-navy);
  }

  .lcs-resort__text {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--lcs-stone);
    text-wrap: balance;
  }

  @media screen and (min-width: 560px) {
    .lcs-resort__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .lcs-resort__media {
      aspect-ratio: 4 / 5;
    }
  }

  @media screen and (min-width: 1000px) {
    .lcs-resort__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.lcs_resort_cards",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.lcs_eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.lcs_heading",
      "default": "四個雪場"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:settings.lcs_subheading"
    }
  ],
  "blocks": [
    {
      "type": "resort",
      "name": "t:names.lcs_resort",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "t:settings.lcs_card_title"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "t:settings.lcs_tag"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:settings.lcs_card_text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.lcs_link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.lcs_image"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:names.lcs_resort_cards",
      "blocks": [
        { "type": "resort" },
        { "type": "resort" },
        { "type": "resort" },
        { "type": "resort" }
      ]
    }
  ]
}
{% endschema %}
