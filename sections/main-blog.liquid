<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<blog-posts-list section-id="{{ section.id }}">
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="
      section
      color-{{ section.settings.color_scheme }}
      blog-posts
      spacing-style
      size-style
    "
    data-testid="blog-posts"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% content_for 'blocks' %}

    {% paginate blog.articles by 9 %}

    <div
      ref="grid"
      class="blog-posts-container"
    >
      {% liquid
        assign items_on_page = paginate.current_offset | plus: blog.articles.size
        assign page_article_count = 0
        for article in blog.articles
          assign page_article_count = page_article_count | plus: 1
        endfor
        assign items_on_page = page_article_count
      %}
      {% assign custom_current_index = 0 %}
      
      {% for article in blog.articles %}
        {% if article.tags contains 'sticky' %}
          {% assign custom_current_index = custom_current_index | plus: 1 %}
        {% liquid
          assign col_span = 2
          assign scale = 0.6
          assign is_horizontal = false

          case items_on_page
            when 1
              assign col_span = 6
              assign scale = 1
              assign is_horizontal = true
            when 2
              assign col_span = 3
              assign scale = 0.8
            when 3
              if custom_current_index == 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              else
                assign col_span = 3
                assign scale = 0.8
              endif
            when 4
              assign col_span = 3
              assign scale = 0.8
            when 5
              if custom_current_index == 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              else
                assign col_span = 3
                assign scale = 0.8
              endif
            else
              if custom_current_index == 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              elsif custom_current_index <= 3
                assign col_span = 3
                assign scale = 0.8
              else
                assign col_span = 2
                assign scale = 0.6
              endif
          endcase
        %}
        {% style %}
          [data-blog-index="{{ section.id }}-{{ custom_current_index }}"] {
            --col-span: {{ col_span }};
            --blog-post-card-scale: {{ scale }};
          }

          @media screen and (max-width: 749px) {
            [data-blog-index="{{ section.id }}-{{ custom_current_index }}"] {
              --col-span: 6;
              --blog-post-card-scale: 0.5;
            }
          }
        {% endstyle %}
        <div
          class="blog-post-item{% if is_horizontal %} blog-post-item--horizontal{% endif %}"
          data-testid="blog-post-item"
          data-blog-index="{{ section.id }}-{{ custom_current_index }}"
        >
          {% content_for 'block', id: 'static-blog-post-card', type: '_blog-post-card', article: article %}
        </div>
        {% endif %}
      {% endfor %}

      {% for article in blog.articles %}
        {% unless article.tags contains 'sticky' %}
          {% assign custom_current_index = custom_current_index | plus: 1 %}
        {% liquid
          assign col_span = 2
          assign scale = 0.6
          assign is_horizontal = false

          case items_on_page
            when 1
              assign col_span = 6
              assign scale = 1
              assign is_horizontal = true
            when 2
              assign col_span = 3
              assign scale = 0.8
            when 3
              if custom_current_index == 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              else
                assign col_span = 3
                assign scale = 0.8
              endif
            when 4
              assign col_span = 3
              assign scale = 0.8
            when 5
              if custom_current_index == 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              else
                assign col_span = 3
                assign scale = 0.8
              endif
            else
              if custom_current_index == 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              elsif custom_current_index <= 3
                assign col_span = 3
                assign scale = 0.8
              else
                assign col_span = 2
                assign scale = 0.6
              endif
          endcase
        %}
        {% style %}
          [data-blog-index="{{ section.id }}-{{ custom_current_index }}"] {
            --col-span: {{ col_span }};
            --blog-post-card-scale: {{ scale }};
          }

          @media screen and (max-width: 749px) {
            [data-blog-index="{{ section.id }}-{{ custom_current_index }}"] {
              --col-span: 6;
              --blog-post-card-scale: 0.5;
            }
          }
        {% endstyle %}
        <div
          class="blog-post-item{% if is_horizontal %} blog-post-item--horizontal{% endif %}"
          data-testid="blog-post-item"
          data-blog-index="{{ section.id }}-{{ custom_current_index }}"
        >
          {% content_for 'block', id: 'static-blog-post-card', type: '_blog-post-card', article: article %}
        </div>
        {% endunless %}
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <nav class="blog-pagination" aria-label="分頁導覽">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" class="blog-pagination__btn blog-pagination__prev">← 上一頁</a>
        {% else %}
          <span class="blog-pagination__btn blog-pagination__prev blog-pagination__btn--disabled">← 上一頁</span>
        {% endif %}

        {% for part in paginate.parts %}
          {% if part.is_link %}
            <a href="{{ part.url }}" class="blog-pagination__btn blog-pagination__page">{{ part.title }}</a>
          {% else %}
            {% if part.title == paginate.current_page %}
              <span class="blog-pagination__btn blog-pagination__page blog-pagination__page--current">{{ part.title }}</span>
            {% else %}
              <span class="blog-pagination__btn blog-pagination__ellipsis">{{ part.title }}</span>
            {% endif %}
          {% endif %}
        {% endfor %}

        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" class="blog-pagination__btn blog-pagination__next">下一頁 →</a>
        {% else %}
          <span class="blog-pagination__btn blog-pagination__next blog-pagination__btn--disabled">下一頁 →</span>
        {% endif %}
      </nav>
    {% endif %}

    {% endpaginate %}

  </div>
</blog-posts-list>

{% stylesheet %}
  .blog-posts {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
    --columns-gap: 36px;
    --rows-gap: 36px;
  }

  .blog-posts-container {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
    width: 100%;
    column-gap: var(--columns-gap);
    row-gap: var(--rows-gap);
  }

  .blog-post-item {
    grid-column: span var(--col-span);
  }

  .blog-post-item {
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    padding: 0 1rem 1rem;
  }

  .blog-post-item:has(.blog-post-card__image-container),
  .blog-post-item:has(.custom-blog-banner-placeholder) {
    border: none !important;
    padding: 0 !important;
  }

  /* 分頁樣式 */
  .blog-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    margin-top: 48px;
    flex-wrap: wrap;
  }

  .blog-pagination__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 10px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.3);
    border-radius: 4px;
    font-size: 14px;
    text-decoration: none;
    color: rgb(var(--color-foreground-rgb));
    background: transparent;
    transition: background 0.2s, color 0.2s;
  }

  a.blog-pagination__btn:hover {
    background: rgb(var(--color-foreground-rgb) / 0.08);
  }

  .blog-pagination__page--current {
    background: rgb(var(--color-foreground-rgb));
    color: rgb(var(--color-background-rgb));
    border-color: rgb(var(--color-foreground-rgb));
    font-weight: bold;
  }

  .blog-pagination__btn--disabled {
    opacity: 0.35;
    cursor: default;
  }

  .blog-pagination__ellipsis {
    border: none;
    padding: 0 4px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" },
    { "type": "text" },
    { "type": "icon" },
    { "type": "image" },
    { "type": "button" },
    { "type": "video" },
    { "type": "group" },
    { "type": "spacer" },
    { "type": "_divider" }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
